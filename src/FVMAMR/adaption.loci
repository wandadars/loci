#include <Loci.h>
#include <mpi_containerIO.h>
#include <parSampleSort.h>
#include <FVMAdapt/sciTypes.h>
#include <FVMAMR/amr.h>
#include <algorithm>
#include <functional>
#include <limits>
#include <vector>

$include "FVM.lh"
$include "FVMAMR/amr.lh"

namespace Loci {

  using std::cout ;
  using std::endl ;
  using std::max ;
  using std::min ;
  using std::vector ;
  typedef real_t real ;

  //---------------------------------------------------------------------------
  // Vars-file defaults and common adaptation controls

  /// Maximum number of adaptation steps to perform. The solver decides how this
  /// limit participates in its timestep loop.
  $rule default(maxAdaptSteps) { $maxAdaptSteps = 0 ; }

  /// adaptMode can be "isotropic", "anisotropic", or "2D".
  $rule default(adaptMode) { $adaptMode = "anisotropic" ; }

  /// Only the literal "2D" selects the planar edge-length guard. All other
  /// modes use the 3D geometry path; the split behavior is handled by FVMAdapt.
  $rule constraint(adaptMode2D,adaptMode3D<-adaptMode) {
    $adaptMode2D = EMPTY ;
    $adaptMode3D = EMPTY ;
    if($adaptMode == "2D") {
      $adaptMode2D = ~EMPTY ;
    } else {
      $adaptMode3D = ~EMPTY ;
    }
  }

  /// Minimum edge length allowed for refinement.
  $rule default(adaptMinEdgeLength) { $adaptMinEdgeLength = 1e-6 ; }

  /// Face folding criterion used by the FVMAdapt remesher.
  $rule default(adaptFaceFold) { $adaptFaceFold = 1.5708 ; }

  /// Reserved compatibility control. The current setup helper does not pass
  /// adaptBalanceType into FVMAdapt.
  $rule default(adaptBalanceType) { $adaptBalanceType = 0 ; }

  /// Solver-side cadence controls.
  $rule optional(adaptFrequency) { $adaptFrequency = 100 ; }
  $rule default(adaptStart) { $adaptStart = 100 ; }

  /// Error thresholds for refinement and coarsening requests from scaledError.
  $rule default(adaptSensitivity) { $adaptSensitivity = 1.0 ; }
  $rule default(coarsenSensitivity) { $coarsenSensitivity = 0.5 ; }

  /// Selects error metrics to use for refinement.
  $rule optional(adaptSensor) { $adaptSensor = "" ; }

  /// Structured selector for module-generated scalar metrics. The startup
  /// helper expands this options list into the parametric selector facts below.
  $rule optional(adaptSensorMetrics) { $adaptSensorMetrics = options_list() ; }

  /// Structured selector for constant request sources used by debug and
  /// regression cases.
  $rule optional(amrConstantRequestSources) {
    $amrConstantRequestSources = options_list() ;
  }

  /// Maximum number of cells in adaptation phase, in millions of cells.
  $rule default(maxAdaptCellCount) { $maxAdaptCellCount = -1. ; }

  $type numCells param<double> ;

  /// Current mesh cell count, in millions, used to cap requested refinement.
  $rule unit(numCells),constraint(UNIVERSE) { $numCells = 0 ; }

  $rule apply(numCells<-vol)[Loci::Summation],constraint(geom_cells),prelude {
    *$numCells += double(seq.size())*1.0e-6 ;
  } ;

  /// Default partition weighting for solvers that do not provide their own
  /// post-AMR repartition hints.
  $rule pointwise(cellPartitionWeights),constraint(geom_cells) {
    $cellPartitionWeights = 1 ;
  }

  /// Maximum number of cells allowed to request refinement in this query.
  $type maxRefineCellCount param<int> ;

  /// Estimate how many cells may be refined before reaching maxAdaptCellCount.
  $rule singleton(maxRefineCellCount<-numCells,maxAdaptCellCount,adaptMode) {
    double factor = 1.e6/7.0 ;
    if($adaptMode == "2D") {
      factor = 1.e6/3.0 ;
    }
    $maxRefineCellCount = std::numeric_limits<int>::max() ;
    if($maxAdaptCellCount > 0) {
      $maxRefineCellCount = int(max($maxAdaptCellCount-$numCells,0.0)*factor) ;
    }
    $[Once] {
      cout << "maxAdaptCellCount=" << $maxAdaptCellCount
           << ", numCells=" << $numCells
           << ", maxRefineCellCount=" << $maxRefineCellCount
           << endl ;
    }
  }

  //---------------------------------------------------------------------------
  // Cell-based adaptation flags

  /// Edge-length estimate used as a refinement guard. This is not a full mesh
  /// quality metric; it only protects cells already below adaptMinEdgeLength.
  $rule unit(cellMaxEdgeLength),constraint(geom_cells) {
    $cellMaxEdgeLength = 0 ;
  }

  /// Estimate cell edge length from 3D face geometry.
  $rule apply((cl,cr)->cellMaxEdgeLength<-area,face2node->pos)[Loci::Maximum],
  constraint(adaptMode3D,(cl,cr)->geom_cells) {
    real len = 0 ;
    int fsz = $face2node.size() ;
    for(int i=0;i<fsz;++i) {
      int ip = ((i+1)==fsz)?0:i+1 ;
      real elen = norm($face2node[ip]->$pos-$face2node[i]->$pos) ;
      join($cl->$cellMaxEdgeLength,elen) ;
      join($cr->$cellMaxEdgeLength,elen) ;
      len += elen ;
    }
    real estlen = 4.0*$area.sada/len ;
    join($cl->$cellMaxEdgeLength,estlen) ;
    join($cr->$cellMaxEdgeLength,estlen) ;
  }

  /// In 2D mode, only faces normal to the z direction contribute to the guard.
  $rule apply(ci->cellMaxEdgeLength<-area,face2node->pos)[Loci::Maximum],
  constraint(adaptMode2D,ci->geom_cells) {
    if(fabs(fabs($area.n.z)-1.0) < 1e-8) {
      real len = 0 ;
      int fsz = $face2node.size() ;
      for(int i=0;i<fsz;++i) {
        int ip = ((i+1)==fsz)?0:i+1 ;
        real elen = norm($face2node[ip]->$pos-$face2node[i]->$pos) ;
        join($ci->$cellMaxEdgeLength,elen) ;
        len += elen ;
      }
      join($ci->$cellMaxEdgeLength,4.*$area.sada/len) ;
    }
  }

  /// Unit/apply sequence for solver-independent refinement protection masks.
  /// Solvers may add additional apply rules to mark cells based on their own
  /// physics or region criteria.
  $rule unit(cellAdaptMask),constraint(geom_cells) {
    $cellAdaptMask = 0 ;
  }

  /// Protect cells that are already below the minimum edge-length target from
  /// additional refinement.
  $rule apply(cellAdaptMask<-cellMaxEdgeLength,adaptMinEdgeLength)
  [Loci::Maximum],constraint(geom_cells) {
    if($cellMaxEdgeLength < $adaptMinEdgeLength) {
      join($cellAdaptMask,1) ;
    }
  }

  //---------------------------------------------------------------------------
  // Sensor normalization and thresholding

  /// Sensor statistics are global scalar normalizers. Solver modules provide
  /// the sensor fields; FVMAMR computes the mean and variance used for thresholding.
  $rule unit(cellMeanCount),constraint(geom_cells) {
    $cellMeanCount = 0 ;
  }

  $rule apply(cellMeanCount<-vol)[Loci::Summation],constraint(geom_cells) {
    join($cellMeanCount,1) ;
  }

  $type Xf store<real> ;

  $rule unit(cellMean(Xf)),constraint(Xf,geom_cells) {
    $cellMean(Xf) = 0 ;
  }

  $rule apply(cellMean(Xf)<-Xf,cellMeanCount)[Loci::Summation] {
    join($cellMean(Xf),double($Xf)/double($cellMeanCount)) ;
  }

  $rule unit(cellSigmaSq(Xf)),constraint(Xf,geom_cells) {
    $cellSigmaSq(Xf) = 0 ;
  }

  $rule apply(cellSigmaSq(Xf)<-Xf,cellMean(Xf),cellMeanCount)[Loci::Summation] {
    double delta = $Xf-$cellMean(Xf) ;
    double term = 0 ;
    if($cellMeanCount > 1)
      term = delta*delta/($cellMeanCount-1) ;
    join($cellSigmaSq(Xf),term) ;
  }

  $type ERRVAR store<real> ;

  /// Count selected sensors contributing to each cell. This keeps the
  /// scaled-error source inactive when no solver metric has been selected.
  $rule unit(scaledErrorSensorCount),constraint(geom_cells) {
    $scaledErrorSensorCount = 0 ;
  }

  $rule apply(scaledErrorSensorCount<-ERRVAR)[Loci::Summation],
  parametric(adaptSensor(ERRVAR)) {
    join($scaledErrorSensorCount,1) ;
  }

  /// Maximum normalized sensor value before applying the no-sensor guard.
  $rule unit(maxScaledError),constraint(geom_cells) {
    $maxScaledError = -std::numeric_limits<real>::max() ;
  }

  /// Default weight for manually supplied sensor facts.
  $rule default(adaptSensorWeight(ERRVAR)),
  parametric(adaptSensor(ERRVAR)) {
    $adaptSensorWeight(ERRVAR) = 1.0 ;
  }

  /// Add normalized sensor values to the scaled-error source. Applications
  /// enable a sensor by creating parametric facts named adaptSensor(ERRVAR).
  $rule apply(maxScaledError<-ERRVAR,cellMean(ERRVAR),
    cellSigmaSq(ERRVAR),adaptSensorWeight(ERRVAR))[Loci::Maximum],
  parametric(adaptSensor(ERRVAR)) {
    real sigma = sqrt($cellSigmaSq(ERRVAR)) ;
    real err_scaled = $adaptSensorWeight(ERRVAR)*
      ($ERRVAR-$cellMean(ERRVAR))/(sigma+1e-30) ;
    join($maxScaledError,err_scaled) ;
  }

  /// Combined normalized sensor value used by the built-in scaled-error
  /// request source. With no selected sensors, the source contributes no AMR
  /// request and the diagnostic value is zero.
  $rule pointwise(totScaledError<-maxScaledError,scaledErrorSensorCount) {
    $totScaledError = 0 ;
    if($scaledErrorSensorCount > 0) {
      $totScaledError = $maxScaledError ;
    }
  }

  $rule unit(limitedAdaptSensitivity),constraint(geom_cells) {
    $limitedAdaptSensitivity = 0 ;
  }

  /// If the requested threshold would exceed the cell-count limit, raise the
  /// effective threshold to the parallel sorted pivot that meets the limit.
  $rule apply(limitedAdaptSensitivity<-totScaledError,scaledErrorSensorCount,
    adaptSensitivity,cellAdaptMask,maxRefineCellCount)[Loci::NullOp],
  option(disable_threading),prelude {
    double sensitivity = *$adaptSensitivity ;
    *$limitedAdaptSensitivity = sensitivity ;

    int cnt = 0 ;
    entitySet domain = entitySet(seq) ;
    FORALL(domain,ii) {
      if($scaledErrorSensorCount[ii] > 0 && $cellAdaptMask[ii] == 0 &&
         $totScaledError[ii] > sensitivity)
        cnt++ ;
    } ENDFORALL ;

    vector<int> refsizes(Loci::MPI_processes,0) ;
    MPI_Allgather(&cnt,1,MPI_INT,&refsizes[0],1,MPI_INT,MPI_COMM_WORLD) ;
    int totsize = 0 ;
    for(int i=0;i<Loci::MPI_processes;++i)
      totsize += refsizes[i] ;

    int targetRefineCells = *$maxRefineCellCount ;
    if(totsize > targetRefineCells) {
      vector<double> errorList(cnt) ;
      cnt = 0 ;
      FORALL(domain,ii) {
        if($scaledErrorSensorCount[ii] > 0 && $cellAdaptMask[ii] == 0 &&
           $totScaledError[ii] > sensitivity)
          errorList[cnt++] = $totScaledError[ii] ;
      } ENDFORALL ;

      Loci::parSampleSort(errorList,std::greater<double>(),MPI_COMM_WORLD) ;

      cnt = errorList.size() ;
      MPI_Allgather(&cnt,1,MPI_INT,&refsizes[0],1,MPI_INT,MPI_COMM_WORLD) ;
      int remainingCells = targetRefineCells ;
      int source_rank = 0 ;
      for(int i=0;i<Loci::MPI_processes;++i) {
        if(remainingCells < refsizes[i]) {
          source_rank = i ;
          break ;
        }
        remainingCells -= refsizes[i] ;
      }

      if(Loci::MPI_rank == source_rank)
        sensitivity = errorList[min<int>(remainingCells,errorList.size()-1)] ;
      MPI_Bcast(&sensitivity,1,MPI_DOUBLE,source_rank,MPI_COMM_WORLD) ;
      *$limitedAdaptSensitivity = sensitivity ;
    }
  } ;

  template <class T> struct AMRFlagCombine {
    void operator()(T &res,const T &arg) const
    {
      if(arg > 0) {
        res = 1 ;
      } else if(arg < 0 && res <= 0) {
        res = -1 ;
      }
    }
  } ;

  template <class T> struct AMRSourceIDCombine {
    void operator()(T &res,const T &arg) const
    {
      if(arg >= 0 && (res < 0 || arg < res))
        res = arg ;
    }
  } ;

  template <class T> struct AMRSelectedRequestCombine {
    void operator()(T &res,const T &arg) const
    {
      if(arg != 0)
        res = arg ;
    }
  } ;

  //---------------------------------------------------------------------------
  // Source-based request fusion

  /// Built-in source representing the generic normalized sensor marker.
  $rule default(amrRequestSource(scaledError)) {
    $amrRequestSource(scaledError) = true ;
  }

  /// Selector that keeps the built-in marker attached only to scaledError.
  $rule default(amrScaledErrorRequestSource(scaledError)) {
    $amrScaledErrorRequestSource(scaledError) = true ;
  }

  /// Stable id used by diagnostics for the built-in scaled-error source.
  $rule default(amrSourceID(scaledError)) {
    $amrSourceID(scaledError) = 0 ;
  }

  /// Default priority for the built-in scaled-error source.
  $rule default(amrSourcePriority(scaledError)) {
    $amrSourcePriority(scaledError) = 0 ;
  }

  /// Category label for the built-in scaled-error source.
  $rule default(amrSourceKind(scaledError)) {
    $amrSourceKind(scaledError) = "error" ;
  }

  /// The built-in scaled-error source is a soft request.
  $rule default(amrSourceHardConstraint(scaledError)) {
    $amrSourceHardConstraint(scaledError) = false ;
  }

  /// Convert the normalized sensor value into the built-in AMR request source.
  $rule pointwise(amrRequest(SRC)<-totScaledError,scaledErrorSensorCount,
  limitedAdaptSensitivity,coarsenSensitivity),
  parametric(amrScaledErrorRequestSource(SRC)) {
    $amrRequest(SRC) = 0 ;
    if($scaledErrorSensorCount > 0) {
      if($totScaledError > $limitedAdaptSensitivity) {
        $amrRequest(SRC) = 1 ;
      } else if($totScaledError < -$coarsenSensitivity) {
        $amrRequest(SRC) = -1 ;
      }
    }
  }

  /// Emit a constant request command for a registered debug source. This is
  /// useful for regression tests of request fusion without solver-specific
  /// sensor rules.
  $rule pointwise(amrRequest(SRC)<-amrConstantRequestCommand(SRC)),
  parametric(amrConstantRequestSource(SRC)) {
    $amrRequest(SRC) =
      amrNormalizeRequestCommand($amrConstantRequestCommand(SRC)) ;
  }

  /// Count source requests for refinement. A solver activates each source by
  /// creating amrRequestSource(SRC) and providing amrRequest(SRC).
  $rule unit(amrRefineRequestCount),constraint(geom_cells) {
    $amrRefineRequestCount = 0 ;
  }

  $rule apply(amrRefineRequestCount<-amrRequest(SRC))[Loci::Summation],
  parametric(amrRequestSource(SRC)) {
    int cnt = ($amrRequest(SRC) > 0)?1:0 ;
    join($amrRefineRequestCount,cnt) ;
  }

  /// Count source requests for coarsening.
  $rule unit(amrCoarsenRequestCount),constraint(geom_cells) {
    $amrCoarsenRequestCount = 0 ;
  }

  $rule apply(amrCoarsenRequestCount<-amrRequest(SRC))[Loci::Summation],
  parametric(amrRequestSource(SRC)) {
    int cnt = ($amrRequest(SRC) < 0)?1:0 ;
    join($amrCoarsenRequestCount,cnt) ;
  }

  /// Priority of the active source chosen by request fusion. Source priority is
  /// compared before the command, so a high-priority coarsening source can beat
  /// a lower-priority refinement source.
  $rule unit(amrWinningPriority),constraint(geom_cells) {
    $amrWinningPriority = std::numeric_limits<int>::min() ;
  }

  $rule apply(amrWinningPriority<-amrRequest(SRC),amrSourcePriority(SRC))
  [Loci::Maximum],
  parametric(amrRequestSource(SRC)) {
    int request = amrNormalizeRequestCommand($amrRequest(SRC)) ;
    int priority = std::numeric_limits<int>::min() ;
    if(request != 0)
      priority = $amrSourcePriority(SRC) ;
    join($amrWinningPriority,priority) ;
  }

  /// Choose a deterministic diagnostic source id for the fused command. Among
  /// active sources at the winning priority, the lowest source id wins.
  $rule unit(amrWinningSource),constraint(geom_cells) {
    $amrWinningSource = -1 ;
  }

  $rule apply(amrWinningSource<-amrWinningPriority,amrRequest(SRC),
  amrSourceID(SRC),amrSourcePriority(SRC))[AMRSourceIDCombine],
  parametric(amrRequestSource(SRC)) {
    int request = amrNormalizeRequestCommand($amrRequest(SRC)) ;
    int source = -1 ;
    if(request != 0 && $amrSourcePriority(SRC) == $amrWinningPriority)
      source = $amrSourceID(SRC) ;
    join($amrWinningSource,source) ;
  }

  /// Final fused command. Once priority fusion chooses a source, that source's
  /// command decides whether this cell refines, coarsens, or remains unchanged.
  $rule unit(amrFusedRequest),constraint(geom_cells) {
    $amrFusedRequest = 0 ;
  }

  $rule apply(amrFusedRequest<-amrWinningSource,amrRequest(SRC),
  amrSourceID(SRC))[AMRSelectedRequestCombine],
  parametric(amrRequestSource(SRC)) {
    int request = 0 ;
    if($amrWinningSource >= 0 && $amrSourceID(SRC) == $amrWinningSource)
      request = amrNormalizeRequestCommand($amrRequest(SRC)) ;
    join($amrFusedRequest,request) ;
  }

  /// Record the command selected by priority-aware request fusion.
  $rule pointwise(amrWinningCommand<-amrFusedRequest) {
    $amrWinningCommand = $amrFusedRequest ;
  }

  /// Count requests that disagreed with the selected command.
  $rule pointwise(amrConflictCount<-amrFusedRequest,amrRefineRequestCount,
  amrCoarsenRequestCount) {
    if($amrFusedRequest > 0) {
      $amrConflictCount = $amrCoarsenRequestCount ;
    } else if($amrFusedRequest < 0) {
      $amrConflictCount = $amrRefineRequestCount ;
    } else {
      $amrConflictCount = $amrRefineRequestCount + $amrCoarsenRequestCount ;
    }
  }

  //---------------------------------------------------------------------------
  // Final AMR marker composition

  /// Module-internal marker after request fusion: 1 refines, -1 coarsens, and
  /// 0 means unchanged. Solver rules should feed amrRequest(SRC), not this fact.
  $rule unit(cellRefFlag),constraint(geom_cells) {
    $cellRefFlag = 0 ;
  }

  /// Add the source-fused AMR request to the final cell marker.
  $rule apply(cellRefFlag<-amrFusedRequest)[AMRFlagCombine] {
    join($cellRefFlag,$amrFusedRequest) ;
  }

  /// Apply geometric protection masks without suppressing coarsening requests.
  $rule pointwise(cellRefFlagMask<-cellAdaptMask,cellRefFlag) {
    $cellRefFlagMask = $cellRefFlag ;
    if($cellRefFlag > 0 && $cellAdaptMask != 0)
      $cellRefFlagMask = 0 ;
  }

  //---------------------------------------------------------------------------
  // AMR requested-decision history

  /// Default level for cells without carried adapted-continuation state.
  $rule pointwise(amrCellLevel),constraint(geom_cells,amr_not_restart) {
    $amrCellLevel = 0 ;
  }

  /// Signed action requested by fusion after final protection masks.
  $rule pointwise(amrRequestedAction<-cellRefFlagMask) {
    $amrRequestedAction = $cellRefFlagMask ;
  }

  /// Source id associated with the requested action, or -1 when no action is
  /// requested for the cell.
  $rule pointwise(amrRequestedWinningSource<-cellRefFlagMask,
  amrWinningSource) {
    $amrRequestedWinningSource = -1 ;
    if($cellRefFlagMask != 0)
      $amrRequestedWinningSource = $amrWinningSource ;
  }

  /// Adaptation step associated with the requested action. refineLevel is the
  /// scheduler-visible AMR cycle identifier available to this module.
  $rule pointwise(amrRequestedAdaptStep<-cellRefFlagMask,refineLevel) {
    $amrRequestedAdaptStep = -1 ;
    if($cellRefFlagMask != 0)
      $amrRequestedAdaptStep = $refineLevel ;
  }

  /// Compatibility aliases for ordinary marking queries. Adapted-continuation
  /// rules replace these with accepted topology actions after remeshing.
  $rule pointwise(amrLastAction<-amrRequestedAction),
  constraint(amr_not_restart) {
    $amrLastAction = $amrRequestedAction ;
  }

  $rule pointwise(amrLastWinningSource<-amrRequestedWinningSource),
  constraint(amr_not_restart) {
    $amrLastWinningSource = $amrRequestedWinningSource ;
  }

  $rule pointwise(amrLastAdaptStep<-amrRequestedAdaptStep),
  constraint(amr_not_restart) {
    $amrLastAdaptStep = $amrRequestedAdaptStep ;
  }

  /// Count positive refinement requests after masking.
  $rule unit(refCount),constraint(UNIVERSE) {
    $refCount = 0 ;
  }

  $rule apply(refCount<-cellRefFlagMask)[Loci::Summation] {
    int cnt = ($cellRefFlagMask > 0)?1:0 ;
    join($refCount,cnt) ;
  }

  /// Count coarsening requests after masking. The fact name follows FVMAdapt's
  /// de-refine terminology.
  $rule unit(derefCount),constraint(UNIVERSE) {
    $derefCount = 0 ;
  }

  $rule apply(derefCount<-cellRefFlagMask)[Loci::Summation] {
    int cnt = ($cellRefFlagMask < 0)?1:0 ;
    join($derefCount,cnt) ;
  }

  /// Solver cadence rules can use adaptTagsActive to avoid requesting an AMR
  /// cycle when the generic tagging pass has selected no cells.
  $rule constraint(adaptTagsActive<-refCount,derefCount) {
    $adaptTagsActive = (($refCount + $derefCount) > 0)?~EMPTY:EMPTY ;
  }

  //---------------------------------------------------------------------------
  // FVMAdapt database staging

  /// Translate FVMAMR's signed marker to the unsigned FVMAdapt tag encoding.
  $rule pointwise(cellRefineTag<-cellRefFlagMask) {
    if($cellRefFlagMask > 0) {
      $cellRefineTag = 1 ;
    } else if($cellRefFlagMask < 0) {
      $cellRefineTag = 2 ;
    } else {
      $cellRefineTag = 0 ;
    }
  }

  /// Count nonzero tags so a no-op marking pass does not trigger remeshing.
  $rule unit(amrTagCount),constraint(UNIVERSE) {
    $amrTagCount = 0 ;
  }

  $rule apply(amrTagCount<-cellRefineTag)[Loci::Summation] {
    int cnt = ($cellRefineTag == 0)?0:1 ;
    join($amrTagCount,cnt) ;
  }

  /// Stage partition weights in file order for FVMAdapt's repartitioning path.
  $rule pointwise(OUTPUT<-cellPartitionWeights),conditional(do_adapt),
  constraint(geom_cells),option(disable_threading),prelude {
    entitySet dom = entitySet(seq) ;
    fact_db::distribute_infoP dist =
      Loci::exec_current_fact_db->get_distribute_info() ;
    int offset = 0 ;
    Loci::storeRepP vardist =
      Loci::Local2FileOrder($cellPartitionWeights.Rep(),dom,offset,dist,
                            MPI_COMM_WORLD) ;
    Loci::replaceAMRDBItem(Loci::AMR_DB_CELL_PARTITION_WEIGHTS,vardist) ;
  } ;

  /// Stage refinement tags in file order. Parent-child maps are cleared here
  /// because they belong to the previous adapted mesh once new tags are issued.
  $rule pointwise(OUTPUT<-cellRefineTag,amrTagCount),conditional(do_adapt),
  constraint(geom_cells),option(disable_threading),prelude {
    Loci::clearAMRParentChildKeys() ;

    if(*$amrTagCount == 0) {
      Loci::deleteAMRDBItem(Loci::AMR_DB_REFINE_TAG) ;
      if(Loci::MPI_rank == 0) {
        cout << "INFO: FVMAMR found no cells marked for adaptation." << endl ;
      }
      return ;
    }

    entitySet dom = entitySet(seq) ;
    fact_db::distribute_infoP dist =
      Loci::exec_current_fact_db->get_distribute_info() ;
    int offset = 0 ;
    Loci::storeRepP vardist =
      Loci::Local2FileOrder($cellRefineTag.Rep(),dom,offset,dist,
                            MPI_COMM_WORLD) ;
    Loci::replaceAMRDBItem(Loci::AMR_DB_REFINE_TAG,vardist) ;
  } ;

  //---------------------------------------------------------------------------
  // Generic nodal and cell extrema helpers

  $type X store<real> ;

  /// Scatter cell or face scalar maxima to surrounding nodes.
  $rule unit(nodalScalarMax(X)),constraint(pos) {
    $nodalScalarMax(X) = std::numeric_limits<real>::lowest() ;
  }

  $rule apply(face2node->nodalScalarMax(X)<-(cl,cr)->X)[Loci::Maximum] {
    const real Xf = max($cl->$X,$cr->$X) ;
    const int fsz = $face2node.size() ;
    for(int i=0;i<fsz;++i)
      join($face2node[i]->$nodalScalarMax(X),realToFloat(Xf)) ;
  }

  $type X_f store<real> ;

  $rule apply(face2node->nodalScalarMax(X)<-X_f)[Loci::Maximum],
  constraint(ci->X) {
    const real Xf = $X_f ;
    const int fsz = $face2node.size() ;
    for(int i=0;i<fsz;++i)
      join($face2node[i]->$nodalScalarMax(X),realToFloat(Xf)) ;
  }

  /// Scatter cell or face scalar minima to surrounding nodes.
  $rule unit(nodalScalarMin(X)),constraint(pos) {
    $nodalScalarMin(X) = std::numeric_limits<real>::max() ;
  }

  $rule apply(face2node->nodalScalarMin(X)<-(cl,cr)->X)[Loci::Minimum] {
    const real Xf = min($cl->$X,$cr->$X) ;
    const int fsz = $face2node.size() ;
    for(int i=0;i<fsz;++i)
      join($face2node[i]->$nodalScalarMin(X),realToFloat(Xf)) ;
  }

  $rule apply(face2node->nodalScalarMin(X)<-X_f)[Loci::Minimum],
  constraint(ci->X) {
    const real Xf = $X_f ;
    const int fsz = $face2node.size() ;
    for(int i=0;i<fsz;++i)
      join($face2node[i]->$nodalScalarMin(X),realToFloat(Xf)) ;
  }

  template <class T> struct Maximumv3d {
    void operator()(T &res,const T &arg)
    {
      res.x = ::max(res.x,arg.x) ;
      res.y = ::max(res.y,arg.y) ;
      res.z = ::max(res.z,arg.z) ;
    }
  } ;

  template <class T> struct Minimumv3d {
    void operator()(T &res,const T &arg)
    {
      res.x = ::min(res.x,arg.x) ;
      res.y = ::min(res.y,arg.y) ;
      res.z = ::min(res.z,arg.z) ;
    }
  } ;

  $type V store<vect3d> ;

  /// Scatter vector-component maxima to surrounding nodes.
  $rule unit(nodalv3dMax(V)),constraint(pos) {
    real m = std::numeric_limits<real>::lowest() ;
    $nodalv3dMax(V) = vector3d<real>(m,m,m) ;
  }

  $rule apply(face2node->nodalv3dMax(V)<-(cl,cr)->V)[Maximumv3d] {
    const vector3d<real> Vf(realToFloat(max($cl->$V.x,$cr->$V.x)),
                            realToFloat(max($cl->$V.y,$cr->$V.y)),
                            realToFloat(max($cl->$V.z,$cr->$V.z))) ;
    const int fsz = $face2node.size() ;
    for(int i=0;i<fsz;++i)
      join($face2node[i]->$nodalv3dMax(V),Vf) ;
  }

  $type V_f store<vect3d> ;

  $rule apply(face2node->nodalv3dMax(V)<-V_f)[Maximumv3d],
  constraint(ci->V) {
    const vector3d<real> Vf = realToFloat($V_f) ;
    const int fsz = $face2node.size() ;
    for(int i=0;i<fsz;++i)
      join($face2node[i]->$nodalv3dMax(V),Vf) ;
  }

  /// Scatter vector-component minima to surrounding nodes.
  $rule unit(nodalv3dMin(V)),constraint(pos) {
    real m = std::numeric_limits<real>::max() ;
    $nodalv3dMin(V) = vector3d<real>(m,m,m) ;
  }

  $rule apply(face2node->nodalv3dMin(V)<-(cl,cr)->V)[Minimumv3d] {
    const vector3d<real> Vf(realToFloat(min($cl->$V.x,$cr->$V.x)),
                            realToFloat(min($cl->$V.y,$cr->$V.y)),
                            realToFloat(min($cl->$V.z,$cr->$V.z))) ;
    const int fsz = $face2node.size() ;
    for(int i=0;i<fsz;++i)
      join($face2node[i]->$nodalv3dMin(V),Vf) ;
  }

  $rule apply(face2node->nodalv3dMin(V)<-V_f)[Minimumv3d],
  constraint(ci->V) {
    const vector3d<real> Vf = realToFloat($V_f) ;
    const int fsz = $face2node.size() ;
    for(int i=0;i<fsz;++i)
      join($face2node[i]->$nodalv3dMin(V),Vf) ;
  }

  $rule pointwise(cellMaxVal(X)<-(upper,lower)->face2node->nodalScalarMax(X)) {
    real Xv = std::numeric_limits<real>::lowest() ;
    const int usz = $upper.size() ;
    for(int i=0;i<usz;++i) {
      const int fsz = $upper[i]->$face2node.size() ;
      for(int j=0;j<fsz;++j)
        Xv = max(Xv,$upper[i]->$face2node[j]->$nodalScalarMax(X)) ;
    }
    const int lsz = $lower.size() ;
    for(int i=0;i<lsz;++i) {
      const int fsz = $lower[i]->$face2node.size() ;
      for(int j=0;j<fsz;++j)
        Xv = max(Xv,$lower[i]->$face2node[j]->$nodalScalarMax(X)) ;
    }
    $cellMaxVal(X) = Xv ;
  }

  $rule pointwise(cellMinVal(X)<-(upper,lower)->face2node->nodalScalarMin(X)) {
    real Xv = std::numeric_limits<real>::max() ;
    const int usz = $upper.size() ;
    for(int i=0;i<usz;++i) {
      const int fsz = $upper[i]->$face2node.size() ;
      for(int j=0;j<fsz;++j)
        Xv = min(Xv,$upper[i]->$face2node[j]->$nodalScalarMin(X)) ;
    }
    const int lsz = $lower.size() ;
    for(int i=0;i<lsz;++i) {
      const int fsz = $lower[i]->$face2node.size() ;
      for(int j=0;j<fsz;++j)
        Xv = min(Xv,$lower[i]->$face2node[j]->$nodalScalarMin(X)) ;
    }
    $cellMinVal(X) = Xv ;
  }

  $rule pointwise(cellMaxVal3d(V)<-(upper,lower)->face2node->nodalv3dMax(V)) {
    real m = std::numeric_limits<real>::lowest() ;
    vector3d<real> Xv(m,m,m) ;
    const int usz = $upper.size() ;
    for(int i=0;i<usz;++i) {
      const int fsz = $upper[i]->$face2node.size() ;
      for(int j=0;j<fsz;++j) {
        Xv.x = max(Xv.x,$upper[i]->$face2node[j]->$nodalv3dMax(V).x) ;
        Xv.y = max(Xv.y,$upper[i]->$face2node[j]->$nodalv3dMax(V).y) ;
        Xv.z = max(Xv.z,$upper[i]->$face2node[j]->$nodalv3dMax(V).z) ;
      }
    }
    const int lsz = $lower.size() ;
    for(int i=0;i<lsz;++i) {
      const int fsz = $lower[i]->$face2node.size() ;
      for(int j=0;j<fsz;++j) {
        Xv.x = max(Xv.x,$lower[i]->$face2node[j]->$nodalv3dMax(V).x) ;
        Xv.y = max(Xv.y,$lower[i]->$face2node[j]->$nodalv3dMax(V).y) ;
        Xv.z = max(Xv.z,$lower[i]->$face2node[j]->$nodalv3dMax(V).z) ;
      }
    }
    $cellMaxVal3d(V) = Xv ;
  }

  $rule pointwise(cellMinVal3d(V)<-(upper,lower)->face2node->nodalv3dMin(V)) {
    real m = std::numeric_limits<real>::max() ;
    vector3d<real> Xv(m,m,m) ;
    const int usz = $upper.size() ;
    for(int i=0;i<usz;++i) {
      const int fsz = $upper[i]->$face2node.size() ;
      for(int j=0;j<fsz;++j) {
        Xv.x = min(Xv.x,$upper[i]->$face2node[j]->$nodalv3dMin(V).x) ;
        Xv.y = min(Xv.y,$upper[i]->$face2node[j]->$nodalv3dMin(V).y) ;
        Xv.z = min(Xv.z,$upper[i]->$face2node[j]->$nodalv3dMin(V).z) ;
      }
    }
    const int lsz = $lower.size() ;
    for(int i=0;i<lsz;++i) {
      const int fsz = $lower[i]->$face2node.size() ;
      for(int j=0;j<fsz;++j) {
        Xv.x = min(Xv.x,$lower[i]->$face2node[j]->$nodalv3dMin(V).x) ;
        Xv.y = min(Xv.y,$lower[i]->$face2node[j]->$nodalv3dMin(V).y) ;
        Xv.z = min(Xv.z,$lower[i]->$face2node[j]->$nodalv3dMin(V).z) ;
      }
    }
    $cellMinVal3d(V) = Xv ;
  }

  /// Geometric cell scale from the center to surrounding face nodes.
  $rule pointwise(cellMaxRadius<-cellcenter,(upper,lower)->face2node->pos) {
    double rmax2 = 0 ;
    const vect3d c = $cellcenter ;
    const int usz = $upper.size() ;
    for(int i=0;i<usz;++i) {
      const int fsz = $upper[i]->$face2node.size() ;
      for(int j=0;j<fsz;++j) {
        const vect3d dv = $upper[i]->$face2node[j]->$pos-c ;
        rmax2 = max(rmax2,realToDouble(dot(dv,dv))) ;
      }
    }
    const int lsz = $lower.size() ;
    for(int i=0;i<lsz;++i) {
      const int fsz = $lower[i]->$face2node.size() ;
      for(int j=0;j<fsz;++j) {
        const vect3d dv = $lower[i]->$face2node[j]->$pos-c ;
        rmax2 = max(rmax2,realToDouble(dot(dv,dv))) ;
      }
    }
    $cellMaxRadius = sqrt(rmax2) ;
  }

  //---------------------------------------------------------------------------
  // Generic face-difference error kernels

  $type Y store<real> ;

  /// Maximum scalar jump across adjacent cells.
  $rule unit(cell_error_s(X,Y)),constraint(geom_cells) {
    $cell_error_s(X,Y) = 0 ;
  }

  $rule apply((cl,cr)->cell_error_s(X,Y)<-X,Y)[Loci::Maximum],
  constraint((cl,cr)->geom_cells,X,Y) {
    real val = realToFloat(fabs($X-$Y)) ;
    join($cl->$cell_error_s(X,Y),val) ;
    join($cr->$cell_error_s(X,Y),val) ;
  }

  $type W store<vect3d> ;

  /// Maximum vector jump magnitude across adjacent cells.
  $rule unit(cell_error_v3d(V,W)),constraint(geom_cells) {
    $cell_error_v3d(V,W) = 0 ;
  }

  $rule apply((cl,cr)->cell_error_v3d(V,W)<-V,W)[Loci::Maximum],
  constraint((cl,cr)->geom_cells,V,W) {
    real val = realToFloat(norm($V-$W)) ;
    join($cl->$cell_error_v3d(V,W),val) ;
    join($cr->$cell_error_v3d(V,W),val) ;
  }

  $type VM storeVec<real> ;
  $type WM storeVec<real> ;
  $type N param<int> ;

  /// Maximum variable-length vector jump magnitude across adjacent cells.
  $rule unit(cell_error_vM(VM,WM,N)),constraint(geom_cells) {
    $cell_error_vM(VM,WM,N) = 0 ;
  }

  $rule apply((cl,cr)->cell_error_vM(VM,WM,N)<-VM,WM,N)[Loci::Maximum],
  constraint((cl,cr)->geom_cells,VM,WM,N) {
    real val = 0 ;
    const int n = max($N,0) ;
    for(int i=0;i<n;++i) {
      const real dv = $VM[i]-$WM[i] ;
      val += dv*dv ;
    }
    val = realToFloat(sqrt(realToDouble(val))) ;
    join($cl->$cell_error_vM(VM,WM,N),val) ;
    join($cr->$cell_error_vM(VM,WM,N),val) ;
  }

  //---------------------------------------------------------------------------
  // Structured face-jump sensor metrics

  $type XS store<real> ;

  /// Module-generated scalar face-jump metric for a selected solver field.
  /// The result is an ordinary scalar sensor store consumed by adaptSensor().
  $rule pointwise(amrScalarFaceJump(XS)<-
    cell_error_s(leftsP(XS,Zero),rightsP(XS,Zero))),
  parametric(amrUseScalarFaceJump(XS)),
  inplace(amrScalarFaceJump(XS)|cell_error_s(leftsP(XS,Zero),rightsP(XS,Zero))),
  prelude {
  } ;

  $type XV store<vect3d> ;

  /// Module-generated 3D-vector face-jump metric for a selected solver field.
  /// The vector jump magnitude is reduced to a scalar sensor store.
  $rule pointwise(amrVectorFaceJump(XV)<-
    cell_error_v3d(leftv3d(XV),rightv3d(XV))),
  parametric(amrUseVectorFaceJump(XV)),
  inplace(amrVectorFaceJump(XV)|cell_error_v3d(leftv3d(XV),rightv3d(XV))),
  prelude {
  } ;

  $type XVM storeVec<real> ;

  /// Module-generated variable-length-vector face-jump metric for a selected
  /// solver field. The component jump norm is reduced to a scalar sensor store.
  $rule pointwise(amrMVectorFaceJump(XVM)<-
    cell_error_vM(leftvM(XVM),rightvM(XVM),vecSize(leftvM(XVM)))),
  parametric(amrUseMVectorFaceJump(XVM)),
  inplace(amrMVectorFaceJump(XVM)|
    cell_error_vM(leftvM(XVM),rightvM(XVM),vecSize(leftvM(XVM)))),
  prelude {
  } ;
}
