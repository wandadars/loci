#include <Loci.h>
#include <FVMAMR/amr.h>
#include <FVMAdapt/defines.h>
#include <string>

$include "FVM.lh"
$include "FVMAMR/amr.lh"

namespace Loci {

  using std::cerr ;
  using std::endl ;

  /// Split ordinary marking queries from adapted-continuation queries. The
  /// driver owns the legacy refineRestart continuation flag and sets it after
  /// replacing the grid in memory.
  $rule constraint(amr_restart,amr_not_restart<-refineRestart) {
    if($refineRestart > 0) {
      $amr_restart = ~EMPTY ;
      $amr_not_restart = EMPTY ;
    } else {
      $amr_restart = EMPTY ;
      $amr_not_restart = ~EMPTY ;
    }
  }

  $type AMRInterpolationMapping blackbox<Loci::AMRinterpolation> ;

  /// Build the accepted lineage map from FVMAdapt's dynamic c2p relation and
  /// the categorical parent facts staged before remeshing.
  $rule blackbox(AMRLineageMap<-refineRestart),
    constraint(amr_restart,geom_cells),prelude {
    storeRepP ap = getAMRDBItem(AMR_DB_REQUESTED_ACTION) ;
    storeRepP sp = getAMRDBItem(AMR_DB_REQUESTED_WINNING_SOURCE) ;
    storeRepP tp = getAMRDBItem(AMR_DB_REQUESTED_ADAPT_STEP) ;
    storeRepP lp = getAMRDBItem(AMR_DB_CELL_LEVEL) ;
    if(ap == 0 || sp == 0 || tp == 0 || lp == 0) {
      cerr << "ERROR: AMR accepted-history metadata not found in DataXFER_DB."
           << endl ;
      Abort() ;
    }

    store<pair<int,int> > c2pg ;
    store<int> requestedAction ;
    store<int> requestedSource ;
    store<int> requestedStep ;
    store<int> cellLevel ;
    c2pg = getC2PGlobal(*exec_current_fact_db) ;
    requestedAction = ap ;
    requestedSource = sp ;
    requestedStep = tp ;
    cellLevel = lp ;
    $AMRLineageMap->setup(c2pg,requestedAction,requestedSource,
                          requestedStep,cellLevel) ;
    requestedAction.allocate(EMPTY) ;
    requestedSource.allocate(EMPTY) ;
    requestedStep.allocate(EMPTY) ;
    cellLevel.allocate(EMPTY) ;
    deleteAMRDBItem(AMR_DB_REQUESTED_ACTION) ;
    deleteAMRDBItem(AMR_DB_REQUESTED_WINNING_SOURCE) ;
    deleteAMRDBItem(AMR_DB_REQUESTED_ADAPT_STEP) ;
    deleteAMRDBItem(AMR_DB_CELL_LEVEL) ;
  } ;

  register_rule<AMRLineageClassification>
    register_AMRLineageClassification ;

  /// Build the interpolation map from the geometric stencil staged before
  /// remeshing and the parent-child map created by FVMAdapt.
  $rule blackbox(AMRInterpolationMapping<-refineRestart,cellcenter,vol),
    constraint(amr_restart,geom_cells),prelude {
    storeRepP gp = getAMRDBItem(AMR_DB_GRAD_CELLS) ;
    storeRepP dp = getAMRDBItem(AMR_DB_DELTAS) ;
    storeRepP vp = getAMRDBItem(AMR_DB_VOL) ;
    if(gp == 0 || dp == 0 || vp == 0) {
      cerr << "ERROR: AMR interpolation metadata not found in DataXFER_DB."
           << endl ;
      Abort() ;
    }

    multiStore<int> gradCells ;
    multiStore<vector3d<double> > deltas ;
    store<double> volw ;
    store<pair<int,int> > c2pg ;

    gradCells = gp ;
    deltas = dp ;
    volw = vp ;
    c2pg = getC2PGlobal(*exec_current_fact_db) ;

    $AMRInterpolationMapping->setupRefinementMapping(c2pg,volw,gradCells,
                                                     deltas,$cellcenter,$vol,
                                                     *exec_current_fact_db) ;

    volw.allocate(EMPTY) ;
    gradCells.allocate(EMPTY) ;
    deltas.allocate(EMPTY) ;
    deleteAMRDBItem(AMR_DB_VOL) ;
    deleteAMRDBItem(AMR_DB_GRAD_CELLS) ;
    deleteAMRDBItem(AMR_DB_DELTAS) ;
    deleteAMRDBItem(AMR_DB_CENTERS) ;
  } ;
}
