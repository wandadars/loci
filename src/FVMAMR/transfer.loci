#include <Loci.h>
#include <FVMAMR/amr.h>
#include <algorithm>
#include <limits>
#include <vector>

$include "FVM.lh"
$include "FVMAMR/amr.lh"

namespace Loci {

  using std::min ;
  using std::vector ;

  /// Stage the FVM geometric stencil and requested AMR decision history used
  /// after remeshing. Neighbor entries are written with file-order cell numbers,
  /// and the staged action/source/step/level stores use the same file-order
  /// partitioning so accepted lineage can be reconstructed on the adapted grid.
  $rule pointwise(OUTPUT<-(upper,lower,boundary_map)->facecenter,
                  lower->cl->fileNumber(geom_cells),
                  upper->cr->fileNumber(geom_cells),
                  cellcenter,vol,amrRequestedAction,
                  amrRequestedWinningSource,amrRequestedAdaptStep,
                  amrCellLevel),
    constraint(geom_cells),conditional(do_adapt),
    option(disable_threading),prelude {
    entitySet dom = entitySet(seq) ;

    store<int> count_dv ;
    store<int> count_iv ;
    count_dv.allocate(dom) ;
    count_iv.allocate(dom) ;
    FORALL(dom,ii) {
      count_iv[ii] = $upper[ii].size()+$lower[ii].size() ;
      count_dv[ii] = count_iv[ii] + $boundary_map[ii].size() ;
    } ENDFORALL ;

    int mn = 0 ;
    int mnl = std::numeric_limits<int>::max() ;
    FORALL(dom,ii) {
      mnl = min(mnl,$fileNumber(geom_cells)[ii]) ;
    } ENDFORALL ;
    MPI_Allreduce(&mnl,&mn,1,MPI_INT,MPI_MIN,MPI_COMM_WORLD) ;

    multiStore<int> gradCells ;
    multiStore<vector3d<double> > deltas ;
    gradCells.allocate(count_iv) ;
    deltas.allocate(count_dv) ;
    FORALL(dom,ii) {
      vect3d center = $cellcenter[ii] ;
      const int usz = $upper[ii].size() ;
      for(int i=0;i<usz;++i) {
        const int cell = $cr[$upper[ii][i]] ;
        gradCells[ii][i] = $fileNumber(geom_cells)[cell]-mn ;
        deltas[ii][i] = ($cellcenter[cell]-center) ;
      }
      const int lsz = $lower[ii].size() ;
      for(int i=0;i<lsz;++i) {
        const int cell = $cl[$lower[ii][i]] ;
        gradCells[ii][usz+i] = $fileNumber(geom_cells)[cell]-mn ;
        deltas[ii][usz+i] = ($cellcenter[cell]-center) ;
      }
      const int bsz = $boundary_map[ii].size() ;
      for(int i=0;i<bsz;++i) {
        const int face = $boundary_map[ii][i] ;
        deltas[ii][usz+lsz+i] = ($facecenter[face]-center) ;
      }
    } ENDFORALL ;

    fact_db::distribute_infoP dist =
      Loci::exec_current_fact_db->get_distribute_info() ;
    replaceAMRDBItem(AMR_DB_GRAD_CELLS,
                     redistributeAMRStoreToFileOrder(gradCells.Rep(),
                                                     dom,dist)) ;
    replaceAMRDBItem(AMR_DB_DELTAS,
                     redistributeAMRStoreToFileOrder(deltas.Rep(),dom,dist)) ;

    store<double> volw ;
    volw.allocate(dom) ;
    FORALL(dom,ii) {
      volw[ii] = $vol[ii] ;
    } ENDFORALL ;
    replaceAMRDBItem(AMR_DB_VOL,
                     redistributeAMRStoreToFileOrder(volw.Rep(),dom,dist)) ;

    store<int> requestedAction ;
    requestedAction.allocate(dom) ;
    store<int> requestedSource ;
    requestedSource.allocate(dom) ;
    store<int> requestedStep ;
    requestedStep.allocate(dom) ;
    store<int> cellLevel ;
    cellLevel.allocate(dom) ;
    FORALL(dom,ii) {
      requestedAction[ii] = $amrRequestedAction[ii] ;
      requestedSource[ii] = $amrRequestedWinningSource[ii] ;
      requestedStep[ii] = $amrRequestedAdaptStep[ii] ;
      cellLevel[ii] = $amrCellLevel[ii] ;
    } ENDFORALL ;
    replaceAMRDBItem(AMR_DB_REQUESTED_ACTION,
                     redistributeAMRStoreToFileOrder(requestedAction.Rep(),
                                                     dom,dist)) ;
    replaceAMRDBItem(AMR_DB_REQUESTED_WINNING_SOURCE,
                     redistributeAMRStoreToFileOrder(requestedSource.Rep(),
                                                     dom,dist)) ;
    replaceAMRDBItem(AMR_DB_REQUESTED_ADAPT_STEP,
                     redistributeAMRStoreToFileOrder(requestedStep.Rep(),
                                                     dom,dist)) ;
    replaceAMRDBItem(AMR_DB_CELL_LEVEL,
                     redistributeAMRStoreToFileOrder(cellLevel.Rep(),
                                                     dom,dist)) ;
  } ;
}
