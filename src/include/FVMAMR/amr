  /// Signed commands used by solver-neutral AMR request composition.
  enum AMRRequestCommand {
    AMR_REQUEST_COARSEN = -1,
    AMR_REQUEST_NONE    = 0,
    AMR_REQUEST_REFINE  = 1
  } ;

  /// Topology changes observed from FVMAdapt's dynamic parent-child map.
  enum AMRTopologyAction {
    AMR_TOPOLOGY_COARSENED = -1,
    AMR_TOPOLOGY_DIRECT    = 0,
    AMR_TOPOLOGY_REFINED   = 1
  } ;

  /// C++ policy vocabulary used to choose one command when AMR request sources
  /// disagree. The current scheduler-visible `.loci` rules implement the
  /// priority/source-id subset of this vocabulary.
  enum AMRFusionPolicy {
    /// Highest source priority wins; request strength breaks priority ties.
    AMR_FUSION_PRIORITY = 0,
    /// Highest request strength wins; source priority breaks strength ties.
    AMR_FUSION_STRENGTH = 1,
    /// Each active source gets one vote for refine or coarsen.
    AMR_FUSION_EQUAL_VOTE = 2,
    /// Source order wins. Changing firstSource between cycles gives a simple
    /// round-robin policy without adding hidden mutable state to the arbiter.
    AMR_FUSION_SOURCE_ORDER = 3
  } ;

  /// Normalize arbitrary signed integers to the AMR request command set.
  inline int amrNormalizeRequestCommand(int command)
  {
    if(command > 0)
      return AMR_REQUEST_REFINE ;
    if(command < 0)
      return AMR_REQUEST_COARSEN ;
    return AMR_REQUEST_NONE ;
  }

  /// Metadata for one source that may request refinement or coarsening.
  struct AMRRequestSource {
    std::string name ;
    std::string kind ;
    int priority ;
    bool hardConstraint ;

    AMRRequestSource() : name(""),kind(""),priority(0),
      hardConstraint(false) {}

    AMRRequestSource(const std::string &sourceName,
                     const std::string &sourceKind,
                     int sourcePriority,
                     bool hard) :
      name(sourceName),kind(sourceKind),priority(sourcePriority),
      hardConstraint(hard) {}
  } ;

  /// One source's request for one cell.
  struct AMRCellRequest {
    int source ;
    int command ;
    double strength ;
    int targetLevel ;
    double targetSize ;

    AMRCellRequest() : source(-1),command(AMR_REQUEST_NONE),
      strength(0.0),targetLevel(-1),targetSize(-1.0) {}

    AMRCellRequest(int sourceID,int requestCommand,double requestStrength) :
      source(sourceID),command(amrNormalizeRequestCommand(requestCommand)),
      strength(requestStrength),targetLevel(-1),targetSize(-1.0) {}

    AMRCellRequest(int sourceID,int requestCommand,double requestStrength,
                   int desiredLevel,double desiredSize) :
      source(sourceID),command(amrNormalizeRequestCommand(requestCommand)),
      strength(requestStrength),targetLevel(desiredLevel),
      targetSize(desiredSize) {}

    bool active() const { return source >= 0 && command != AMR_REQUEST_NONE ; }
  } ;

  /// Rules used by AMRRequestArbiter when fusing requests.
  struct AMRFusionRules {
    AMRFusionPolicy policy ;
    bool hardConstraintsFirst ;
    bool preferRefineOnTie ;
    bool keepOnEqualVoteTie ;
    int firstSource ;

    AMRFusionRules() : policy(AMR_FUSION_PRIORITY),
      hardConstraintsFirst(true),preferRefineOnTie(true),
      keepOnEqualVoteTie(true),firstSource(0) {}
  } ;

  /// Result of fusing all active requests for one cell.
  struct AMRFusionResult {
    int command ;
    int winningSource ;
    double winningStrength ;
    int refineRequestCount ;
    int coarsenRequestCount ;
    int conflictCount ;

    AMRFusionResult() : command(AMR_REQUEST_NONE),winningSource(-1),
      winningStrength(0.0),refineRequestCount(0),coarsenRequestCount(0),
      conflictCount(0) {}
  } ;

  /// Source registry and deterministic request-fusion helper for custom C++
  /// policies.
  ///
  /// The stock .loci schedule does not consult this object; it uses
  /// amrSourcePriority(SRC), then the lowest amrSourceID(SRC), then the selected
  /// source's command. Custom C++ rules can assemble AMRCellRequest values and
  /// call fuse() directly when a richer policy is needed.
  class AMRRequestArbiter {
    std::vector<AMRRequestSource> sources ;
    AMRFusionRules rules ;

    bool validSource(int source) const
    {
      return source >= 0 && source < int(sources.size()) ;
    }

    bool sourceIsHard(int source) const
    {
      return validSource(source) && sources[source].hardConstraint ;
    }

    int sourcePriority(int source) const
    {
      if(validSource(source))
        return sources[source].priority ;
      return 0 ;
    }

    int sourceOrderRank(int source) const
    {
      const int nsrc = int(sources.size()) ;
      if(nsrc <= 0)
        return source ;

      int first = rules.firstSource%nsrc ;
      if(first < 0)
        first += nsrc ;

      int rank = source-first ;
      if(rank < 0)
        rank += nsrc ;
      return rank ;
    }

    bool winsByPriority(const AMRCellRequest &a,
                        const AMRCellRequest &b) const
    {
      const int ap = sourcePriority(a.source) ;
      const int bp = sourcePriority(b.source) ;
      if(ap != bp)
        return ap > bp ;
      if(a.strength != b.strength)
        return a.strength > b.strength ;
      if(a.command != b.command && rules.preferRefineOnTie)
        return a.command > b.command ;
      return a.source < b.source ;
    }

    bool winsByStrength(const AMRCellRequest &a,
                        const AMRCellRequest &b) const
    {
      if(a.strength != b.strength)
        return a.strength > b.strength ;
      const int ap = sourcePriority(a.source) ;
      const int bp = sourcePriority(b.source) ;
      if(ap != bp)
        return ap > bp ;
      if(a.command != b.command && rules.preferRefineOnTie)
        return a.command > b.command ;
      return a.source < b.source ;
    }

    bool winsBySourceOrder(const AMRCellRequest &a,
                           const AMRCellRequest &b) const
    {
      const int ar = sourceOrderRank(a.source) ;
      const int br = sourceOrderRank(b.source) ;
      if(ar != br)
        return ar < br ;
      if(a.strength != b.strength)
        return a.strength > b.strength ;
      return winsByPriority(a,b) ;
    }

    bool requestWins(const AMRCellRequest &a,
                     const AMRCellRequest &b) const
    {
      if(rules.hardConstraintsFirst) {
        const bool ah = sourceIsHard(a.source) ;
        const bool bh = sourceIsHard(b.source) ;
        if(ah != bh)
          return ah ;
      }

      if(rules.policy == AMR_FUSION_STRENGTH)
        return winsByStrength(a,b) ;
      if(rules.policy == AMR_FUSION_SOURCE_ORDER)
        return winsBySourceOrder(a,b) ;
      return winsByPriority(a,b) ;
    }

  public:
    AMRRequestArbiter() {}

    explicit AMRRequestArbiter(const AMRFusionRules &fusionRules) :
      rules(fusionRules) {}

    void clearSources() { sources.clear() ; }

    int addSource(const std::string &name,const std::string &kind,
                  int priority,bool hardConstraint)
    {
      const int existing = sourceIndex(name) ;
      if(existing >= 0)
        return existing ;
      sources.push_back(AMRRequestSource(name,kind,priority,hardConstraint)) ;
      return int(sources.size())-1 ;
    }

    int sourceIndex(const std::string &name) const
    {
      for(size_t i=0;i<sources.size();++i)
        if(sources[i].name == name)
          return int(i) ;
      return -1 ;
    }

    const AMRRequestSource &source(int sourceID) const
    {
      return sources[sourceID] ;
    }

    const std::vector<AMRRequestSource> &requestSources() const
    {
      return sources ;
    }

    size_t numSources() const { return sources.size() ; }

    void setRules(const AMRFusionRules &fusionRules)
    {
      rules = fusionRules ;
    }

    const AMRFusionRules &fusionRules() const { return rules ; }

    AMRFusionResult fuse(const std::vector<AMRCellRequest> &requests) const
    {
      AMRFusionResult result ;
      bool hardOnly = false ;
      if(rules.hardConstraintsFirst) {
        for(size_t i=0;i<requests.size();++i) {
          if(requests[i].active() && sourceIsHard(requests[i].source)) {
            hardOnly = true ;
            break ;
          }
        }
      }

      int activeCount = 0 ;
      for(size_t i=0;i<requests.size();++i) {
        const AMRCellRequest &req = requests[i] ;
        if(!req.active())
          continue ;
        if(hardOnly && !sourceIsHard(req.source))
          continue ;

        activeCount++ ;
        if(req.command == AMR_REQUEST_REFINE)
          result.refineRequestCount++ ;
        else if(req.command == AMR_REQUEST_COARSEN)
          result.coarsenRequestCount++ ;
      }

      if(activeCount == 0)
        return result ;

      int voteCommand = AMR_REQUEST_NONE ;
      if(rules.policy == AMR_FUSION_EQUAL_VOTE) {
        if(result.refineRequestCount > result.coarsenRequestCount) {
          voteCommand = AMR_REQUEST_REFINE ;
        } else if(result.coarsenRequestCount > result.refineRequestCount) {
          voteCommand = AMR_REQUEST_COARSEN ;
        } else if(!rules.keepOnEqualVoteTie) {
          voteCommand = rules.preferRefineOnTie ?
            AMR_REQUEST_REFINE : AMR_REQUEST_COARSEN ;
        }

        if(voteCommand == AMR_REQUEST_NONE) {
          result.conflictCount = activeCount ;
          return result ;
        }
      }

      bool haveWinner = false ;
      AMRCellRequest winner ;
      for(size_t i=0;i<requests.size();++i) {
        const AMRCellRequest &req = requests[i] ;
        if(!req.active())
          continue ;
        if(hardOnly && !sourceIsHard(req.source))
          continue ;
        if(voteCommand != AMR_REQUEST_NONE && req.command != voteCommand)
          continue ;

        if(!haveWinner || requestWins(req,winner)) {
          winner = req ;
          haveWinner = true ;
        }
      }

      if(!haveWinner)
        return result ;

      result.command = winner.command ;
      result.winningSource = winner.source ;
      result.winningStrength = winner.strength ;

      for(size_t i=0;i<requests.size();++i) {
        const AMRCellRequest &req = requests[i] ;
        if(!req.active())
          continue ;
        if(hardOnly && !sourceIsHard(req.source))
          continue ;
        if(req.command != result.command)
          result.conflictCount++ ;
      }

      return result ;
    }
  } ;

  /// Typed names for FVMAdapt DataXFER_DB entries used by the online in-memory
  /// adaptation path. These enum keys reserve the common FVMAMR/FVMAdapt string
  /// names; solver field keys should use solver-specific names to avoid
  /// collisions in the shared DataXFER_DB staging area.
  enum AMRDBKey {
    AMR_DB_ADAPT_CYCLE,
    AMR_DB_REFINE_TAG,
    AMR_DB_CELL_WEIGHTS,
    AMR_DB_CURRENT_PLAN,
    AMR_DB_NEXT_PLAN,
    AMR_DB_C2P,
    AMR_DB_C2P_GLOBAL,
    AMR_DB_REQUESTED_ACTION,
    AMR_DB_REQUESTED_WINNING_SOURCE,
    AMR_DB_REQUESTED_ADAPT_STEP,
    AMR_DB_CELL_LEVEL,
    AMR_DB_CELL_PARTITION_WEIGHTS,
    AMR_DB_GRAD_CELLS,
    AMR_DB_DELTAS,
    AMR_DB_VOL,
    AMR_DB_CENTERS
  } ;

  /// Return the DataXFER_DB key string associated with a typed AMR key.
  inline const char *amrDBKeyName(AMRDBKey key)
  {
    switch(key) {
    case AMR_DB_ADAPT_CYCLE:            return "adaptCycle" ;
    case AMR_DB_REFINE_TAG:             return "refineTag" ;
    case AMR_DB_CELL_WEIGHTS:           return "cellweights" ;
    case AMR_DB_CURRENT_PLAN:           return "currentPlan" ;
    case AMR_DB_NEXT_PLAN:              return "nextPlan" ;
    case AMR_DB_C2P:                    return "c2p" ;
    case AMR_DB_C2P_GLOBAL:             return "c2pglobal" ;
    case AMR_DB_REQUESTED_ACTION:       return "amrRequestedAction" ;
    case AMR_DB_REQUESTED_WINNING_SOURCE:
      return "amrRequestedWinningSource" ;
    case AMR_DB_REQUESTED_ADAPT_STEP:   return "amrRequestedAdaptStep" ;
    case AMR_DB_CELL_LEVEL:             return "amrCellLevel" ;
    case AMR_DB_CELL_PARTITION_WEIGHTS: return "cellPartitionWeights" ;
    case AMR_DB_GRAD_CELLS:             return "gradCells" ;
    case AMR_DB_DELTAS:                 return "deltas" ;
    case AMR_DB_VOL:                    return "vol" ;
    case AMR_DB_CENTERS:                return "centers" ;
    }
    return "" ;
  }

  /// Fetch a DataXFER_DB item by raw key name. This returns the staged object,
  /// not a copy. Prefer the enum overload when the key is part of the common
  /// FVMAMR/FVMAdapt contract.
  inline storeRepP getAMRDBItem(const std::string &keyName)
  {
    return DataXFER_DB.getItem(keyName) ;
  }

  /// Fetch a common AMR DataXFER_DB item by typed key.
  inline storeRepP getAMRDBItem(AMRDBKey key)
  {
    return getAMRDBItem(amrDBKeyName(key)) ;
  }

  /// Test whether a raw DataXFER_DB key is currently staged.
  inline bool hasAMRDBItem(const std::string &keyName)
  {
    return getAMRDBItem(keyName) != 0 ;
  }

  /// Test whether a common AMR key is currently staged.
  inline bool hasAMRDBItem(AMRDBKey key)
  {
    return getAMRDBItem(key) != 0 ;
  }

  /// Replace a raw DataXFER_DB entry. The old value is deleted first, so this is
  /// destructive for any previous owner of the same key.
  inline void replaceAMRDBItem(const std::string &keyName,storeRepP item)
  {
    DataXFER_DB.deleteItem(keyName) ;
    DataXFER_DB.insertItem(keyName,item) ;
  }

  /// Replace a common AMR DataXFER_DB entry.
  inline void replaceAMRDBItem(AMRDBKey key,storeRepP item)
  {
    replaceAMRDBItem(amrDBKeyName(key),item) ;
  }

  /// Delete a raw DataXFER_DB entry if present.
  inline void deleteAMRDBItem(const std::string &keyName)
  {
    DataXFER_DB.deleteItem(keyName) ;
  }

  /// Delete a common AMR DataXFER_DB entry if present.
  inline void deleteAMRDBItem(AMRDBKey key)
  {
    deleteAMRDBItem(amrDBKeyName(key)) ;
  }

  /// Remove stale parent-child maps before a newly adapted mesh is staged.
  inline void clearAMRParentChildKeys()
  {
    deleteAMRDBItem(AMR_DB_C2P) ;
    deleteAMRDBItem(AMR_DB_C2P_GLOBAL) ;
  }

  /// One parent contribution to a current cell's accepted AMR history.
  struct AMRParentHistory {
    int parent ;
    int requestedAction ;
    int requestedSource ;
    int requestedStep ;
    int cellLevel ;
    int childCount ;

    AMRParentHistory() : parent(-1),requestedAction(AMR_REQUEST_NONE),
      requestedSource(-1),requestedStep(-1),cellLevel(0),childCount(0) {}

    AMRParentHistory(int parentID,int action,int source,int step,int level,
                     int parentChildCount) :
      parent(parentID),requestedAction(amrNormalizeRequestCommand(action)),
      requestedSource(source),requestedStep(step),
      cellLevel(std::max(0,level)),childCount(parentChildCount)
    {}
  } ;

  /// One current-cell view of the dynamic parent-child relation emitted by
  /// FVMAdapt. Child ids are current global cell numbers; parent ids are the
  /// normalized file-order keys used by the staged parent stores.
  struct AMRLineageInfo {
    int mapped ;
    int topologyAction ;
    int parentCount ;
    int childCount ;
    int acceptedAction ;
    int acceptedWinningSource ;
    int acceptedAdaptStep ;
    int cellLevel ;
    std::vector<AMRParentHistory> parents ;

    AMRLineageInfo() : mapped(0),topologyAction(AMR_TOPOLOGY_DIRECT),
      parentCount(0),childCount(0),acceptedAction(AMR_REQUEST_NONE),
      acceptedWinningSource(-1),acceptedAdaptStep(-1),cellLevel(0) {}
  } ;

  /// Solver-neutral classifier for the dynamic FVMAdapt c2p/c2pglobal map and
  /// the categorical parent history staged before remeshing.
  ///
  /// The class intentionally does not interpret currentPlan or nextPlan. It
  /// projects the accepted remesh relation into small per-cell facts.
  class AMRLineageMap {
    std::map<int,AMRLineageInfo> childInfo ;

    static int localMinOrMax(entitySet dom)
    {
      if(dom == EMPTY)
        return std::numeric_limits<int>::max() ;
      return dom.Min() ;
    }

    static int globalMin(int localValue)
    {
      int value = localValue ;
      MPI_Allreduce(&localValue,&value,1,MPI_INT,MPI_MIN,MPI_COMM_WORLD) ;
      return value ;
    }

    static int ownerForEntity(const std::vector<entitySet> &ptn,int entity)
    {
      for(size_t i=0;i<ptn.size();++i)
        if(ptn[i].inSet(entity))
          return int(i) ;
      return -1 ;
    }

    static void fillParentChildCounts(const std::map<int,int> &localCounts,
                                      const std::vector<entitySet> &parentPtn,
                                      store<int> &parentChildCounts)
    {
      entitySet parentDomain = parentChildCounts.domain() ;
      FORALL(parentDomain,ii) {
        parentChildCounts[ii] = 0 ;
      } ENDFORALL ;

      int p = 1 ;
      int r = 0 ;
      MPI_Comm_size(MPI_COMM_WORLD,&p) ;
      MPI_Comm_rank(MPI_COMM_WORLD,&r) ;

      std::vector<std::vector<std::pair<int,int> > > sendByRank(p) ;
      for(std::map<int,int>::const_iterator ci=localCounts.begin();
          ci!=localCounts.end();++ci) {
        const int owner = ownerForEntity(parentPtn,ci->first) ;
        if(owner < 0) {
          std::cerr << "ERROR: AMR parent " << ci->first
                    << " is not owned by the staged parent history."
                    << std::endl ;
          Abort() ;
        }
        sendByRank[owner].push_back(*ci) ;
      }

      std::vector<int> sendCounts(p,0),recvCounts(p,0) ;
      for(int i=0;i<p;++i)
        sendCounts[i] = int(sendByRank[i].size()) ;
      MPI_Alltoall(&sendCounts[0],1,MPI_INT,
                   &recvCounts[0],1,MPI_INT,MPI_COMM_WORLD) ;

      std::vector<int> sendOffsets(p,0),recvOffsets(p,0) ;
      for(int i=1;i<p;++i) {
        sendOffsets[i] = sendOffsets[i-1]+sendCounts[i-1] ;
        recvOffsets[i] = recvOffsets[i-1]+recvCounts[i-1] ;
      }

      const int sendSize = sendOffsets[p-1]+sendCounts[p-1] ;
      const int recvSize = recvOffsets[p-1]+recvCounts[p-1] ;
      std::vector<std::pair<int,int> > sendBuffer(sendSize) ;
      std::vector<std::pair<int,int> > recvBuffer(recvSize) ;
      for(int i=0;i<p;++i)
        std::copy(sendByRank[i].begin(),sendByRank[i].end(),
                  sendBuffer.begin()+sendOffsets[i]) ;

      MPI_Datatype bytearray ;
      MPI_Type_vector(sizeof(std::pair<int,int>),1,1,MPI_BYTE,&bytearray) ;
      MPI_Type_commit(&bytearray) ;
      MPI_Alltoallv(sendBuffer.empty()?0:&sendBuffer[0],
                    &sendCounts[0],&sendOffsets[0],bytearray,
                    recvBuffer.empty()?0:&recvBuffer[0],
                    &recvCounts[0],&recvOffsets[0],bytearray,
                    MPI_COMM_WORLD) ;
      MPI_Type_free(&bytearray) ;

      for(size_t i=0;i<recvBuffer.size();++i) {
        const int parent = recvBuffer[i].first ;
        if(!parentDomain.inSet(parent)) {
          std::cerr << "ERROR: AMR parent " << parent
                    << " was delivered to rank " << r
                    << " but is not locally staged." << std::endl ;
          Abort() ;
        }
        parentChildCounts[parent] += recvBuffer[i].second ;
      }
    }

    static int parentLevelForAction(const AMRLineageInfo &info)
    {
      if(info.parents.empty())
        return 0 ;

      if(info.topologyAction == AMR_TOPOLOGY_COARSENED) {
        int level = std::numeric_limits<int>::max() ;
        for(size_t i=0;i<info.parents.size();++i)
          level = std::min(level,info.parents[i].cellLevel) ;
        if(level == std::numeric_limits<int>::max())
          level = 0 ;
        return std::max(0,level-1) ;
      }

      int level = info.parents[0].cellLevel ;
      if(info.topologyAction == AMR_TOPOLOGY_REFINED)
        level++ ;
      return std::max(0,level) ;
    }

    static void chooseAcceptedSource(AMRLineageInfo &info)
    {
      const int action = info.topologyAction ;
      info.acceptedAction = action ;
      info.acceptedWinningSource = -1 ;
      info.acceptedAdaptStep = -1 ;

      if(action == AMR_TOPOLOGY_DIRECT)
        return ;

      int matchedStep = -1 ;
      for(size_t i=0;i<info.parents.size();++i) {
        const AMRParentHistory &parent = info.parents[i] ;
        if(parent.requestedAction != action)
          continue ;

        matchedStep = std::max(matchedStep,parent.requestedStep) ;
        if(parent.requestedSource < 0)
          continue ;

        if(info.acceptedWinningSource < 0 ||
           parent.requestedSource < info.acceptedWinningSource ||
           (parent.requestedSource == info.acceptedWinningSource &&
            parent.requestedStep > info.acceptedAdaptStep)) {
          info.acceptedWinningSource = parent.requestedSource ;
          info.acceptedAdaptStep = parent.requestedStep ;
        }
      }

      if(info.acceptedWinningSource < 0)
        info.acceptedAdaptStep = matchedStep ;
    }

  public:
    void clear() { childInfo.clear() ; }

    void setup(const store<std::pair<int,int> > &c2pg,
               const store<int> &parentRequestedAction,
               const store<int> &parentRequestedSource,
               const store<int> &parentRequestedStep,
               const store<int> &parentCellLevel)
    {
      clear() ;

      entitySet dom = c2pg.domain() ;
      const int parentMinLocal = localMinOrMax(parentRequestedAction.domain()) ;
      const int parentMin = globalMin(parentMinLocal) ;
      if(parentMin == std::numeric_limits<int>::max()) {
        std::cerr << "ERROR: staged AMR parent history is empty." << std::endl ;
        Abort() ;
      }

      int c2pParentMinLocal = std::numeric_limits<int>::max() ;
      FORALL(dom,ii) {
        c2pParentMinLocal = std::min(c2pParentMinLocal,c2pg[ii].second) ;
      } ENDFORALL ;
      const int c2pParentMin = globalMin(c2pParentMinLocal) ;
      if(c2pParentMin == std::numeric_limits<int>::max())
        return ;

      entitySet requestSet ;
      std::map<int,int> localParentChildCount ;
      FORALL(dom,ii) {
        const int parent = c2pg[ii].second-c2pParentMin+parentMin ;
        requestSet += parent ;
        localParentChildCount[parent]++ ;
      } ENDFORALL ;

      entitySet parentDomain = parentRequestedAction.domain() ;
      std::vector<entitySet> parentPtn =
        all_collect_vectors(parentDomain,MPI_COMM_WORLD) ;
      store<int> parentChildCounts ;
      parentChildCounts.allocate(parentDomain) ;
      fillParentChildCounts(localParentChildCount,parentPtn,
                            parentChildCounts) ;

      dataPartitionP parentPartition =
        createPartition(parentPtn,MPI_COMM_WORLD) ;
      gatherCommSchedule parentComm ;
      parentComm.generateSchedule(requestSet,parentPartition) ;

      store<int> requestedActionData ;
      store<int> requestedSourceData ;
      store<int> requestedStepData ;
      store<int> cellLevelData ;
      store<int> parentChildCountData ;
      parentComm.gatherData(requestedActionData,parentRequestedAction) ;
      parentComm.gatherData(requestedSourceData,parentRequestedSource) ;
      parentComm.gatherData(requestedStepData,parentRequestedStep) ;
      parentComm.gatherData(cellLevelData,parentCellLevel) ;
      parentComm.gatherData(parentChildCountData,parentChildCounts) ;

      std::map<int,int> parentToLocal ;
      getLocalContextMap(parentToLocal,requestSet) ;

      FORALL(dom,ii) {
        const int child = c2pg[ii].first ;
        const int parent = c2pg[ii].second-c2pParentMin+parentMin ;
        std::map<int,int>::const_iterator pi = parentToLocal.find(parent) ;
        if(pi == parentToLocal.end()) {
          std::cerr << "ERROR: AMR parent " << parent
                    << " was not gathered for accepted history." << std::endl ;
          Abort() ;
        }

        const int loc = pi->second ;
        AMRLineageInfo &info = childInfo[child] ;
        info.mapped = 1 ;
        info.parents.push_back(AMRParentHistory(parent,
                                                requestedActionData[loc],
                                                requestedSourceData[loc],
                                                requestedStepData[loc],
                                                cellLevelData[loc],
                                                parentChildCountData[loc])) ;
      } ENDFORALL ;

      for(std::map<int,AMRLineageInfo>::iterator ci=childInfo.begin();
          ci!=childInfo.end();++ci) {
        AMRLineageInfo &info = ci->second ;
        info.parentCount = int(info.parents.size()) ;
        info.childCount = 0 ;
        for(size_t i=0;i<info.parents.size();++i) {
          info.childCount = std::max(info.childCount,
                                     info.parents[i].childCount) ;
        }

        if(info.parentCount > 1) {
          info.topologyAction = AMR_TOPOLOGY_COARSENED ;
        } else if(info.childCount > 1) {
          info.topologyAction = AMR_TOPOLOGY_REFINED ;
        } else {
          info.topologyAction = AMR_TOPOLOGY_DIRECT ;
        }

        info.cellLevel = parentLevelForAction(info) ;
        chooseAcceptedSource(info) ;
      }
    }

    AMRLineageInfo info(int child) const
    {
      std::map<int,AMRLineageInfo>::const_iterator ci =
        childInfo.find(child) ;
      if(ci == childInfo.end())
        return AMRLineageInfo() ;
      return ci->second ;
    }

  } ;

  /// Project AMRLineageMap into scheduler-visible topology and accepted-action
  /// facts on the adapted mesh.
  class AMRLineageClassification : public pointwise_rule {
    const_blackbox<AMRLineageMap> lineage ;
    const_param<int> refineLevel ;
    store<int> topologyAction ;
    store<int> lineageMapped ;
    store<int> lineageParentCount ;
    store<int> lineageChildCount ;
    store<int> acceptedAction ;
    store<int> acceptedWinningSource ;
    store<int> acceptedAdaptStep ;
    store<int> cellLevel ;
    store<int> lastAction ;
    store<int> lastWinningSource ;
    store<int> lastAdaptStep ;

  public:
    AMRLineageClassification()
    {
      name_store("AMRLineageMap",lineage) ;
      name_store("refineLevel",refineLevel) ;
      name_store("amrTopologyAction",topologyAction) ;
      name_store("amrLineageMapped",lineageMapped) ;
      name_store("amrLineageParentCount",lineageParentCount) ;
      name_store("amrLineageChildCount",lineageChildCount) ;
      name_store("amrAcceptedAction",acceptedAction) ;
      name_store("amrAcceptedWinningSource",acceptedWinningSource) ;
      name_store("amrAcceptedAdaptStep",acceptedAdaptStep) ;
      name_store("amrCellLevel",cellLevel) ;
      name_store("amrLastAction",lastAction) ;
      name_store("amrLastWinningSource",lastWinningSource) ;
      name_store("amrLastAdaptStep",lastAdaptStep) ;
      input("AMRLineageMap") ;
      input("refineLevel") ;
      output("amrTopologyAction") ;
      output("amrLineageMapped") ;
      output("amrLineageParentCount") ;
      output("amrLineageChildCount") ;
      output("amrAcceptedAction") ;
      output("amrAcceptedWinningSource") ;
      output("amrAcceptedAdaptStep") ;
      output("amrCellLevel") ;
      output("amrLastAction") ;
      output("amrLastWinningSource") ;
      output("amrLastAdaptStep") ;
      constraint("amr_restart") ;
      constraint("geom_cells") ;
      disable_threading() ;
    }

    void compute(const sequence &seq)
    {
      fact_db::distribute_infoP dist =
        exec_current_fact_db->get_distribute_info() ;
      for(sequence::const_iterator si=seq.begin();si!=seq.end();++si) {
        Entity cell = *si ;
        Entity lookup = cell ;
        if(dist != 0)
          lookup = dist->l2g[cell] ;
        AMRLineageInfo info = lineage->info(lookup) ;
        const int action = info.mapped ? info.topologyAction :
          AMR_TOPOLOGY_DIRECT ;
        int step = info.acceptedAdaptStep ;
        if(action != AMR_TOPOLOGY_DIRECT && step < 0)
          step = *refineLevel ;
        const int source = info.acceptedWinningSource ;

        topologyAction[cell] = action ;
        lineageMapped[cell] = info.mapped ;
        lineageParentCount[cell] = info.parentCount ;
        lineageChildCount[cell] = info.childCount ;
        acceptedAction[cell] = action ;
        acceptedWinningSource[cell] = source ;
        acceptedAdaptStep[cell] = step ;
        cellLevel[cell] = info.cellLevel ;
        lastAction[cell] = action ;
        lastWinningSource[cell] = source ;
        lastAdaptStep[cell] = step ;
      }
    }
  } ;

