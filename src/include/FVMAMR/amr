  /// Parse one top-level adaptSensorMetrics option. Supported concise forms are:
  /// field, field=weight, field=kernel, field=[type=...,kernel=...,weight=...],
  /// and field=kernel(type=...,weight=...).
  inline AMRMetricInputSpec parseAMRMetricInputSpec(const options_list &metrics,
                                                    const std::string &field)
  {
    AMRMetricInputSpec spec ;
    spec.field = field ;

    option_value_type valueType = metrics.getOptionValueType(field) ;
    if(valueType == BOOLEAN) {
      bool enabled = true ;
      metrics.getOption(field,enabled) ;
      if(!enabled) {
        spec.enabled = false ;
      }
      return spec ;
    } else if(valueType == REAL) {
      metrics.getOption(field,spec.weight) ;
    } else if(valueType == LIST) {
      options_list::arg_list valueList ;
      metrics.getOption(field,valueList) ;
      options_list options = amrOptionsFromList(valueList,field) ;
      spec.type = amrGetOptionName(options,"type",spec.type,field) ;
      spec.kernel = amrGetOptionName(options,"kernel",spec.kernel,field) ;
      spec.weight = amrGetOptionDouble(options,"weight",spec.weight,field) ;
    } else if(valueType == FUNCTION) {
      std::string kernel ;
      options_list::arg_list valueList ;
      metrics.getOption(field,kernel,valueList) ;
      spec.kernel = kernel ;
      options_list options = amrOptionsFromList(valueList,field) ;
      spec.type = amrGetOptionName(options,"type",spec.type,field) ;
      spec.weight = amrGetOptionDouble(options,"weight",spec.weight,field) ;
    } else if(valueType == NAME || valueType == STRING) {
      option_values optionValue = metrics.getOption(field) ;
      optionValue.get_value(spec.kernel) ;
    } else {
      if(MPI_rank == 0) {
        std::cerr << "ERROR: Unable to interpret adaptSensorMetrics entry '"
                  << field << "'" << std::endl ;
      }
      Abort() ;
    }

    if(spec.weight < 0.0) {
      if(MPI_rank == 0) {
        std::cerr << "ERROR: Negative AMR sensor weight for '" << field
                  << "'" << std::endl ;
      }
      Abort() ;
    }

    return spec ;
  }

  /// Parse one top-level amrConstantRequestSources option. Supported forms are
  /// source=refine, source=coarsen, source=0, and
  /// source=[command=coarsen,id=20,priority=10,kind=debug,hard=false].
  inline AMRConstantRequestSourceSpec parseAMRConstantRequestSourceSpec(
    const options_list &sources,const std::string &name)
  {
    AMRConstantRequestSourceSpec spec ;
    spec.name = name ;

    option_value_type valueType = sources.getOptionValueType(name) ;
    if(valueType == BOOLEAN) {
      bool enabled = true ;
      sources.getOption(name,enabled) ;
      spec.enabled = enabled ;
      return spec ;
    } else if(valueType == REAL) {
      double value = 0.0 ;
      sources.getOption(name,value) ;
      spec.command = amrNormalizeRequestCommand(int(value)) ;
    } else if(valueType == NAME || valueType == STRING) {
      option_values optionValue = sources.getOption(name) ;
      std::string command ;
      optionValue.get_value(command) ;
      spec.command = amrRequestCommandFromName(command,name) ;
    } else if(valueType == LIST) {
      options_list::arg_list valueList ;
      sources.getOption(name,valueList) ;
      options_list options = amrOptionsFromList(valueList,name) ;
      spec.command = amrGetRequestCommandOption(options,"command",
                                                spec.command,name) ;
      spec.sourceID = amrGetOptionInt(options,"id",spec.sourceID,name) ;
      spec.priority = amrGetOptionInt(options,"priority",
                                      spec.priority,name) ;
      spec.kind = amrGetOptionName(options,"kind",spec.kind,name) ;
      spec.hardConstraint = amrGetOptionBool(options,"hard",
                                             spec.hardConstraint,name) ;
      spec.enabled = amrGetOptionBool(options,"enabled",spec.enabled,name) ;
    } else {
      if(MPI_rank == 0) {
        std::cerr << "ERROR: Unable to interpret amrConstantRequestSources "
                  << "entry '" << name << "'" << std::endl ;
      }
      Abort() ;
    }

    if(spec.command == AMR_REQUEST_NONE)
      spec.enabled = false ;
    return spec ;
  }

  inline double amrGetDistanceThresholdOption(const options_list &options,
                                              const std::string &longName,
                                              const std::string &shortName,
                                              double defaultValue,
                                              const std::string &context)
  {
    double value = defaultValue ;
    if(options.optionExists(longName))
      value = amrGetOptionDouble(options,longName,value,context) ;
    if(options.optionExists(shortName))
      value = amrGetOptionDouble(options,shortName,value,context) ;
    return value ;
  }

  /// Parse one boundary-distance source option. Supported form:
  /// source=[boundary=cylinder,id=2,priority=20,refineLessThan=0.002,
  ///         coarsenGreaterThan=0.006].
  inline AMRBoundaryDistanceSourceSpec
  parseAMRBoundaryDistanceSourceSpec(const options_list &sources,
                                     const std::string &name)
  {
    AMRBoundaryDistanceSourceSpec spec ;
    spec.name = name ;

    option_value_type valueType = sources.getOptionValueType(name) ;
    if(valueType == BOOLEAN) {
      bool enabled = true ;
      sources.getOption(name,enabled) ;
      spec.enabled = enabled ;
      return spec ;
    } else if(valueType == NAME || valueType == STRING) {
      option_values optionValue = sources.getOption(name) ;
      optionValue.get_value(spec.boundary) ;
    } else if(valueType == LIST) {
      options_list::arg_list valueList ;
      sources.getOption(name,valueList) ;
      options_list options = amrOptionsFromList(valueList,name) ;
      spec.boundary = amrGetOptionName(options,"boundary",spec.boundary,name) ;
      spec.sourceID = amrGetOptionInt(options,"id",spec.sourceID,name) ;
      spec.priority = amrGetOptionInt(options,"priority",
                                      spec.priority,name) ;
      spec.kind = amrGetOptionName(options,"kind",spec.kind,name) ;
      spec.hardConstraint = amrGetOptionBool(options,"hard",
                                             spec.hardConstraint,name) ;
      spec.enabled = amrGetOptionBool(options,"enabled",spec.enabled,name) ;
      spec.refineLessThan =
        amrGetDistanceThresholdOption(options,"refineLessThan","refineLT",
                                      spec.refineLessThan,name) ;
      spec.refineGreaterThan =
        amrGetDistanceThresholdOption(options,"refineGreaterThan","refineGT",
                                      spec.refineGreaterThan,name) ;
      spec.coarsenLessThan =
        amrGetDistanceThresholdOption(options,"coarsenLessThan","coarsenLT",
                                      spec.coarsenLessThan,name) ;
      spec.coarsenGreaterThan =
        amrGetDistanceThresholdOption(options,"coarsenGreaterThan","coarsenGT",
                                      spec.coarsenGreaterThan,name) ;
    } else {
      if(MPI_rank == 0) {
        std::cerr << "ERROR: Unable to interpret "
                  << "AMR boundary distance source '" << name << "'"
                  << std::endl ;
      }
      Abort() ;
    }

    if(spec.enabled && spec.boundary == "") {
      if(MPI_rank == 0) {
        std::cerr << "ERROR: AMR boundary distance source '" << name
                  << "' requires a boundary name" << std::endl ;
      }
      Abort() ;
    }

    return spec ;
  }

  /// Return the scalar metric store produced by the selected module kernel. The
  /// current module-owned kernel is faceJump for scalar, vector, and mvector
  /// solver fields.
  inline std::string amrMetricStoreName(const AMRMetricInputSpec &spec)
  {
    if(spec.kernel != "faceJump") {
      if(MPI_rank == 0) {
        std::cerr << "ERROR: Unknown AMR sensor kernel '" << spec.kernel
                  << "' for field '" << spec.field << "'" << std::endl ;
      }
      Abort() ;
    }

    if(spec.type == "scalar")
      return amrParametricName("amrScalarFaceJump",spec.field) ;
    if(spec.type == "vector" || spec.type == "v3d")
      return amrParametricName("amrVectorFaceJump",spec.field) ;
    if(spec.type == "mvector" || spec.type == "storeVec")
      return amrParametricName("amrMVectorFaceJump",spec.field) ;

    if(MPI_rank == 0) {
      std::cerr << "ERROR: Unknown AMR sensor field type '" << spec.type
                << "' for field '" << spec.field << "'" << std::endl ;
    }
    Abort() ;
    return "" ;
  }

  /// Create selector facts that instantiate the requested metric rule family,
  /// then select the generated scalar metric for the scaled-error source.
  inline void createAMRMetricInputFacts(fact_db &facts,
                                        const AMRMetricInputSpec &spec)
  {
    std::string selector ;
    if(spec.type == "scalar") {
      selector = amrParametricName("amrUseScalarFaceJump",spec.field) ;
    } else if(spec.type == "vector" || spec.type == "v3d") {
      selector = amrParametricName("amrUseVectorFaceJump",spec.field) ;
    } else if(spec.type == "mvector" || spec.type == "storeVec") {
      selector = amrParametricName("amrUseMVectorFaceJump",spec.field) ;
    } else {
      amrMetricStoreName(spec) ;
    }

    createAMRBoolFact(facts,selector) ;
    createAdaptSensorFact(facts,amrMetricStoreName(spec),spec.weight) ;
  }

  inline void createAMRConstantRequestSourceFacts(
    fact_db &facts,const AMRConstantRequestSourceSpec &spec)
  {
    createAMRRequestSourceFacts(facts,spec.name,spec.sourceID,
                                spec.priority,spec.kind,
                                spec.hardConstraint) ;
    createAMRBoolFact(facts,
                      amrParametricName("amrConstantRequestSource",
                                        spec.name)) ;
    createAMRIntFact(facts,
                     amrParametricName("amrConstantRequestCommand",
                                       spec.name),
                     spec.command) ;
  }

  inline void setupAMRBoundaryDistanceSourceFacts(fact_db &facts,
                                                  const std::string &optionName,
                                                  int &nextSourceID)
  {
    storeRepP boundarySourcePtr = facts.get_variable(optionName) ;
    if(boundarySourcePtr == 0)
      return ;

    param<options_list> boundarySources ;
    boundarySources = boundarySourcePtr ;

    options_list::option_namelist sourceNames =
      (*boundarySources).getOptionNameList() ;
    for(options_list::option_namelist::const_iterator
        si=sourceNames.begin();si!=sourceNames.end();++si) {
      AMRBoundaryDistanceSourceSpec spec =
        parseAMRBoundaryDistanceSourceSpec(*boundarySources,*si) ;
      if(!spec.enabled)
        continue ;
      if(spec.sourceID < 0)
        spec.sourceID = nextSourceID ;
      nextSourceID = std::max(nextSourceID,spec.sourceID+1) ;
      createAMRBoundaryDistanceSourceFacts(
        facts,spec.name,spec.boundary,spec.sourceID,spec.priority,spec.kind,
        spec.hardConstraint,spec.refineLessThan,spec.refineGreaterThan,
        spec.coarsenLessThan,spec.coarsenGreaterThan) ;
    }
  }

  /// Historical setup helper for FVMAMR facts. Call during fact-database setup,
  /// before building an AMR-capable query schedule. Sensor and constant-source
  /// expansion can run after vars facts are loaded; boundary-distance sources
  /// require grid/boundary facts and should be expanded after those facts exist.
  inline void setupAdaptSensorFacts(fact_db &facts)
  {
    storeRepP asensor = facts.get_variable("adaptSensor") ;
    if(asensor != 0) {
      param<std::string> adaptSensor ;
      adaptSensor = asensor ;
      const std::string sensorList = *adaptSensor ;

      if(sensorList != "") {
        exprP ep = expression::create(sensorList) ;
        if(ep == 0) {
          if(MPI_rank == 0)
            std::cerr << "ERROR: Unable to interpret expression in 'adaptSensor'"
                      << std::endl ;
          Abort() ;
        }

        exprList sensors = collect_associative_op(ep,OP_COMMA) ;
        for(exprList::const_iterator li=sensors.begin();li!=sensors.end();++li) {
          if((*li)->op != OP_NAME) {
            if(MPI_rank == 0) {
              std::cerr << "ERROR: Unable to interpret expression in 'adaptSensor'"
                        << std::endl ;
              (*li)->Print(std::cerr) ;
            }
            Abort() ;
          }
          createAdaptSensorFact(facts,(*li)->name) ;
        }
      }
    }

    storeRepP metricPtr = facts.get_variable("adaptSensorMetrics") ;
    if(metricPtr != 0) {
      param<options_list> adaptSensorMetrics ;
      adaptSensorMetrics = metricPtr ;

      options_list::option_namelist metricNames =
        (*adaptSensorMetrics).getOptionNameList() ;
      for(options_list::option_namelist::const_iterator
          mi=metricNames.begin();mi!=metricNames.end();++mi) {
        AMRMetricInputSpec spec =
          parseAMRMetricInputSpec(*adaptSensorMetrics,*mi) ;
        if(!spec.enabled || spec.weight == 0.0)
          continue ;
        createAMRMetricInputFacts(facts,spec) ;
      }
    }

    storeRepP constantSourcePtr =
      facts.get_variable("amrConstantRequestSources") ;
    if(constantSourcePtr != 0) {
      param<options_list> constantSources ;
      constantSources = constantSourcePtr ;

      options_list::option_namelist sourceNames =
        (*constantSources).getOptionNameList() ;
      int nextSourceID = 1000 ;
      for(options_list::option_namelist::const_iterator
          si=sourceNames.begin();si!=sourceNames.end();++si) {
        AMRConstantRequestSourceSpec spec =
          parseAMRConstantRequestSourceSpec(*constantSources,*si) ;
        if(!spec.enabled)
          continue ;
        if(spec.sourceID < 0)
          spec.sourceID = nextSourceID ;
        nextSourceID = std::max(nextSourceID,spec.sourceID+1) ;
        createAMRConstantRequestSourceFacts(facts,spec) ;
      }
    }

    int nextBoundarySourceID = 2000 ;
    setupAMRBoundaryDistanceSourceFacts(facts,"amrBoundaryDistanceSources",
                                        nextBoundarySourceID) ;
    setupAMRBoundaryDistanceSourceFacts(facts,
                                        "amrNamedBoundaryDistanceSources",
                                        nextBoundarySourceID) ;
  }

  /// Clearer alias for setupAdaptSensorFacts(). New solver code may call this
  /// name; setupAdaptSensorFacts() remains for existing Stream/Chem-style setup.
  inline void setupFVMAMRFacts(fact_db &facts)
  {
    setupAdaptSensorFacts(facts) ;
  }

  /// Create setup facts that register one AMR request source for parametric
  /// rules. This is a schedule-construction operation, not a rule to call from
  /// inside a running Loci schedule. sourceID must be unique across active
  /// sources because selected requests are recovered by id, but this helper does
  /// not validate global uniqueness. Existing facts are preserved. kind and
  /// hardConstraint are diagnostics/future-policy metadata for the stock .loci
  /// schedule.
  inline void createAMRRequestSourceFacts(fact_db &facts,
                                          const std::string &name,
                                          int sourceID,
                                          int priority,
                                          const std::string &kind,
                                          bool hardConstraint)
  {
    const std::string prefix = std::string("(") + name + std::string(")") ;

    const std::string sourceVar =
      std::string("amrRequestSource") + prefix ;
    if(facts.get_variable(sourceVar) == 0) {
      param<bool> source ;
      *source = true ;
      facts.create_fact(sourceVar,source) ;
    }

    const std::string idVar = std::string("amrSourceID") + prefix ;
    if(facts.get_variable(idVar) == 0) {
      param<int> id ;
      *id = sourceID ;
      facts.create_fact(idVar,id) ;
    }

    const std::string priorityVar =
      std::string("amrSourcePriority") + prefix ;
    if(facts.get_variable(priorityVar) == 0) {
      param<int> sourcePriority ;
      *sourcePriority = priority ;
      facts.create_fact(priorityVar,sourcePriority) ;
    }

    const std::string kindVar = std::string("amrSourceKind") + prefix ;
    if(facts.get_variable(kindVar) == 0) {
      param<std::string> sourceKind ;
      *sourceKind = kind ;
      facts.create_fact(kindVar,sourceKind) ;
    }

    const std::string hardVar =
      std::string("amrSourceHardConstraint") + prefix ;
    if(facts.get_variable(hardVar) == 0) {
      param<bool> hard ;
      *hard = hardConstraint ;
      facts.create_fact(hardVar,hard) ;
    }
  }

  /// Register a source that converts a precomputed distance store into AMR
  /// requests. A solver rule or boundary-distance helper must provide
  /// amrDistanceToTarget(name). Negative
  /// thresholds are disabled; if all thresholds are negative the source emits
  /// keep. If refine and coarsen tests both match, refinement wins in the live
  /// distance rule.
  inline void createAMRDistanceRequestSourceFacts(
    fact_db &facts,
    const std::string &name,
    int sourceID,
    int priority,
    const std::string &kind,
    bool hardConstraint,
    double refineLessThan = -1.0,
    double refineGreaterThan = -1.0,
    double coarsenLessThan = -1.0,
    double coarsenGreaterThan = -1.0,
    const std::string &targetName = "")
  {
    createAMRRequestSourceFacts(facts,name,sourceID,priority,kind,
                                hardConstraint) ;
    createAMRBoolFact(facts,
                      amrParametricName("amrDistanceRequestSource",name)) ;
    createAMRDoubleFact(facts,
                        amrParametricName("amrDistanceRefineLessThan",name),
                        refineLessThan) ;
    createAMRDoubleFact(facts,
                        amrParametricName("amrDistanceRefineGreaterThan",name),
                        refineGreaterThan) ;
    createAMRDoubleFact(facts,
                        amrParametricName("amrDistanceCoarsenLessThan",name),
                        coarsenLessThan) ;
    createAMRDoubleFact(facts,
                        amrParametricName("amrDistanceCoarsenGreaterThan",
                                          name),
                        coarsenGreaterThan) ;
    if(targetName != "") {
      createAMRStringFact(facts,
                          amrParametricName("amrDistanceTargetName",name),
                          targetName) ;
    }
  }

  inline storeRepP amrRequireFact(fact_db &facts,const std::string &name,
                                  const std::string &context)
  {
    storeRepP fact = facts.get_variable(name) ;
    if(fact == 0) {
      if(MPI_rank == 0) {
        std::cerr << "ERROR: AMR helper '" << context
                  << "' requires fact '" << name << "'" << std::endl ;
      }
      Abort() ;
    }
    return fact ;
  }

  /// Return the faces belonging to one mesh boundary name.
  inline entitySet createAMRBoundaryFaceSet(fact_db &facts,
                                            const std::string &source,
                                            const std::string &boundary)
  {
    const std::string context =
      std::string("createAMRBoundaryFaceSet(") + source + ")" ;

    storeRepP refRep = amrRequireFact(facts,"ref",context) ;
    storeRepP boundaryNamesRep =
      amrRequireFact(facts,"boundary_names",context) ;
    storeRepP boundaryFacesRep =
      amrRequireFact(facts,"boundary_faces",context) ;
    constraint boundaryFaces ;
    boundaryFaces = boundaryFacesRep ;

    entitySet targetFaces =
      get_boundary_faces(boundary,refRep,boundaryNamesRep,*boundaryFaces) ;
    if(!GLOBAL_OR(targetFaces.size() != 0)) {
      if(MPI_rank == 0) {
        std::cerr << "ERROR: AMR boundary distance source '" << source
                  << "' could not find boundary '" << boundary << "'"
                  << std::endl ;
      }
      Abort() ;
    }

    return targetFaces ;
  }

  /// Build a cell-to-nearest-face map for one named boundary. The search uses
  /// face centers and mirrors the volume-tag partitioning used by Stream's
  /// wall-distance setup so disconnected volume regions do not search each
  /// other's boundary faces.
  inline storeRepP createAMRClosestBoundaryFaceMap(fact_db &facts,
                                                   const std::string &source,
                                                   const std::string &boundary)
  {
    const std::string context =
      std::string("createAMRClosestBoundaryFaceMap(") + source + ")" ;

    const std::string boundaryFacesVar =
      amrParametricName("amrBoundaryFaces",source) ;
    entitySet targetFaces ;
    storeRepP targetFacesRep = facts.get_variable(boundaryFacesVar) ;
    if(targetFacesRep != 0) {
      constraint targetBoundaryFaces ;
      targetBoundaryFaces = targetFacesRep ;
      targetFaces = *targetBoundaryFaces ;
    } else {
      targetFaces = createAMRBoundaryFaceSet(facts,source,boundary) ;
    }

    multiMap face2node(amrRequireFact(facts,"face2node",context)) ;
    store<vect3d> posStatic(amrRequireFact(facts,"pos",context)) ;
    entitySet faceDomain = face2node.domain() ;

    dstore<vect3d> pos ;
    FORALL(posStatic.domain(),pi) {
      pos[pi] = posStatic[pi] ;
    } ENDFORALL ;

    if(MPI_processes > 1) {
      entitySet totalDom = pos.domain() ;
      totalDom += MapRepP(face2node.Rep())->image(faceDomain) ;
      entitySet outDom = totalDom-pos.domain() ;
      storeRepP posRep = pos.Rep() ;
      fill_clone(posRep,outDom,facts.get_init_ptn()) ;
    }

    dstore<vect3d> facecenter ;
    dstore<real_t> faceArea ;
    FORALL(faceDomain,fc) {
      vect3d nodesum(0.0,0.0,0.0) ;
      real_t lensum = 0 ;
      const int fsz = face2node[fc].size() ;
      for(int id=0;id<fsz;++id) {
        const int nd1 = id ;
        const int nd2 = (id+1 == fsz)?0:id+1 ;
        const vect3d p1 = pos[face2node[fc][nd1]] ;
        const vect3d p2 = pos[face2node[fc][nd2]] ;
        const vect3d edgeCenter = 0.5*(p1+p2) ;
        const real_t len = norm(p1-p2) ;
        nodesum += len*edgeCenter ;
        lensum += len ;
      }

      const vect3d center = nodesum/lensum ;
      facecenter[fc] = center ;

      vect3d areaSum(0.0,0.0,0.0) ;
      for(int id=0;id<fsz;++id) {
        const int nd1 = id ;
        const int nd2 = (id+1 == fsz)?0:id+1 ;
        const vect3d p1 = pos[face2node[fc][nd1]] ;
        const vect3d p2 = pos[face2node[fc][nd2]] ;
        areaSum += cross(p1-center,p2-center) ;
      }
      faceArea[fc] = 0.5*norm(areaSum) ;
    } ENDFORALL ;
    pos.setRep(dstore<vect3d>().Rep()) ;

    multiMap upper(amrRequireFact(facts,"upper",context)) ;
    multiMap lower(amrRequireFact(facts,"lower",context)) ;
    multiMap boundaryMap(amrRequireFact(facts,"boundary_map",context)) ;
    constraint geomCells ;
    geomCells = amrRequireFact(facts,"geom_cells",context) ;

#ifdef LOCI_HAS_STATIC_KEYSPACE
    const int faceKeySpace = face2node.Rep()->getDomainKeySpace() ;
#endif

    if(MPI_processes > 1) {
      entitySet faceOut = faceDomain ;
      faceOut += MapRepP(lower.Rep())->image(*geomCells) ;
      faceOut += MapRepP(boundaryMap.Rep())->image(*geomCells) ;
      faceOut += MapRepP(upper.Rep())->image(*geomCells) ;
      storeRepP facecenterRep = facecenter.Rep() ;
      storeRepP faceAreaRep = faceArea.Rep() ;
#ifdef LOCI_HAS_STATIC_KEYSPACE
      std::vector<entitySet> initPtn = facts.get_init_ptn(faceKeySpace) ;
#else
      std::vector<entitySet> initPtn = facts.get_init_ptn() ;
#endif
      fill_clone(facecenterRep,faceOut,initPtn) ;
      fill_clone(faceAreaRep,faceOut,initPtn) ;
    }

    store<vect3d> cellcenter ;
    cellcenter.allocate(*geomCells) ;
    FORALL(*geomCells,cc) {
      vect3d nodesum(0.0,0.0,0.0) ;
      real_t areasum = 0 ;
      for(Entity *id=upper.begin(cc);id!=upper.end(cc);++id) {
        const real_t w = faceArea[*id] ;
        nodesum += facecenter[*id]*w ;
        areasum += w ;
      }
      for(Entity *id=lower.begin(cc);id!=lower.end(cc);++id) {
        const real_t w = faceArea[*id] ;
        nodesum += facecenter[*id]*w ;
        areasum += w ;
      }
      for(Entity *id=boundaryMap.begin(cc);id!=boundaryMap.end(cc);++id) {
        const real_t w = faceArea[*id] ;
        nodesum += facecenter[*id]*w ;
        areasum += w ;
      }
      cellcenter[cc] = nodesum/areasum ;
    } ENDFORALL ;

    std::map<std::string,entitySet> volumeSets ;
    variableSet vars = facts.get_extensional_facts() ;
    for(variableSet::const_iterator vi=vars.begin();vi!=vars.end();++vi) {
      variable var(*vi) ;
      if(var.get_arg_list().size() > 0 && var.get_info().name == "volumeTag") {
        param<std::string> volumeName(facts.get_variable(*vi)) ;
        std::ostringstream varName ;
        varName << *vi ;
        volumeSets[varName.str()] = volumeName.domain() ;
      }
    }
    if(volumeSets.empty())
      volumeSets["volumeTag(Main)"] = ~EMPTY ;

    std::vector<entitySet> volumeCellSets ;
    for(std::map<std::string,entitySet>::const_iterator vi=volumeSets.begin();
        vi!=volumeSets.end();++vi)
      volumeCellSets.push_back(all_collect_entitySet(vi->second)) ;

    Map cl(amrRequireFact(facts,"cl",context)) ;
    std::map<int,int> closestByCell ;
    entitySet mapDomain ;

    for(size_t i=0;i<volumeCellSets.size();++i) {
      entitySet faceSet ;
      for(entitySet::const_iterator fi=targetFaces.begin();
          fi!=targetFaces.end();++fi) {
        if(volumeCellSets[i].inSet(cl[*fi]))
          faceSet += *fi ;
      }

      entitySet cellSet = *geomCells & volumeCellSets[i] ;
      if(!GLOBAL_OR(faceSet.size() != 0))
        continue ;

      std::vector<kdTree::coord3d> targetPoints(faceSet.size()) ;
      std::vector<int> targetIDs(faceSet.size()) ;
      int cnt = 0 ;
      FORALL(faceSet,fc) {
        targetPoints[cnt][0] = facecenter[fc].x ;
        targetPoints[cnt][1] = facecenter[fc].y ;
        targetPoints[cnt][2] = facecenter[fc].z ;
        targetIDs[cnt] = fc ;
        ++cnt ;
      } ENDFORALL ;

      std::vector<kdTree::coord3d> cellPoints(cellSet.size()) ;
      std::vector<int> closest(cellSet.size(),-1) ;
      cnt = 0 ;
      FORALL(cellSet,cc) {
        cellPoints[cnt][0] = cellcenter[cc].x ;
        cellPoints[cnt][1] = cellcenter[cc].y ;
        cellPoints[cnt][2] = cellcenter[cc].z ;
        ++cnt ;
      } ENDFORALL ;

      parallelNearestNeighbors(targetPoints,targetIDs,cellPoints,closest,
                               MPI_COMM_WORLD) ;

      cnt = 0 ;
      FORALL(cellSet,cc) {
        if(closest[cnt] >= 0) {
          mapDomain += cc ;
          closestByCell[cc] = closest[cnt] ;
        }
        ++cnt ;
      } ENDFORALL ;
    }

    if(!GLOBAL_OR(mapDomain.size() != 0)) {
      if(MPI_rank == 0) {
        std::cerr << "ERROR: AMR boundary distance source '" << source
                  << "' could not map any cells to boundary '" << boundary
                  << "'" << std::endl ;
      }
      Abort() ;
    }

    Map closestFace ;
    closestFace.allocate(mapDomain) ;
    FORALL(mapDomain,cc) {
      closestFace[cc] = closestByCell[cc] ;
    } ENDFORALL ;

#ifdef LOCI_HAS_STATIC_KEYSPACE
    MapRepP(closestFace.Rep())->setRangeKeySpace(faceKeySpace) ;
#endif

    return closestFace.Rep() ;
  }

  /// Register a distance request source built from the nearest face on a mesh
  /// boundary. This computes current-mesh boundary-face and closest-face facts
  /// immediately, so rerun it after remeshing on the rebuilt fact database. The
  /// boundary argument is the mesh boundary name recorded in boundary_names and
  /// normally used as a boundary_conditions key.
  inline void createAMRBoundaryDistanceSourceFacts(
    fact_db &facts,
    const std::string &name,
    const std::string &boundary,
    int sourceID,
    int priority,
    const std::string &kind,
    bool hardConstraint,
    double refineLessThan = -1.0,
    double refineGreaterThan = -1.0,
    double coarsenLessThan = -1.0,
    double coarsenGreaterThan = -1.0)
  {
    createAMRDistanceRequestSourceFacts(facts,name,sourceID,priority,kind,
                                        hardConstraint,refineLessThan,
                                        refineGreaterThan,coarsenLessThan,
                                        coarsenGreaterThan,boundary) ;
    createAMRBoolFact(facts,
                      amrParametricName("amrBoundaryDistanceSource",name)) ;

    const std::string boundaryFacesVar =
      amrParametricName("amrBoundaryFaces",name) ;
    if(facts.get_variable(boundaryFacesVar) == 0) {
      entitySet targetFaces =
        createAMRBoundaryFaceSet(facts,name,boundary) ;
      storeRepP boundaryFacesRep =
        amrRequireFact(facts,"boundary_faces",
                       "createAMRBoundaryDistanceSourceFacts") ;
      createAMRConstraintFact(facts,boundaryFacesVar,targetFaces,
                              boundaryFacesRep->getDomainKeySpace()) ;
    }

    const std::string closestVar =
      amrParametricName("amrClosestBoundaryFace",name) ;
    if(facts.get_variable(closestVar) == 0) {
      storeRepP closest =
        createAMRClosestBoundaryFaceMap(facts,name,boundary) ;
      facts.create_fact(closestVar,closest) ;
    }
  }

