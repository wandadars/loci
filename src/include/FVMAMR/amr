  /// Convenience macros that register solver-specific transfer and restart rules.
  /// The solver supplies every Loci variable name, database key, constraint, and
  /// conditional so FVMAMR does not assume a particular physics package or time
  /// naming convention. Restart rules consume and delete their DataXFER_DB key
  /// after interpolation, so each restarted output should use a unique key unless
  /// the solver intentionally implements shared consumption.
  ///
  /// Transfer macros stage CURRENT_VAR and PREVIOUS_VAR into CURRENT_KEY and
  /// PREVIOUS_KEY when CONDITIONAL_NAME is true on DOMAIN_CONSTRAINT. OUTPUT_NAME
  /// is only the synthetic query target for the staging rule. Restart macros read
  /// DB_KEY, write OUTPUT_VAR, run on RESTART_CONSTRAINT and DOMAIN_CONSTRAINT,
  /// and use RESTART_FLAG and MAPPING_NAME as input dependencies.
#define FVMAMR_TRANSFER_SCALAR_RULE(RULE_NAME,CURRENT_VAR,PREVIOUS_VAR, \
                                    CURRENT_KEY,PREVIOUS_KEY, \
                                    CONSTRAINT_NAME,CONDITIONAL_NAME, \
                                    DOMAIN_CONSTRAINT,OUTPUT_NAME) \
  class RULE_NAME : public Loci::AMRTransferScalar {\
  public:\
    RULE_NAME() : Loci::AMRTransferScalar(CURRENT_VAR,PREVIOUS_VAR, \
      CURRENT_KEY,PREVIOUS_KEY,CONSTRAINT_NAME,CONDITIONAL_NAME, \
      DOMAIN_CONSTRAINT,OUTPUT_NAME) {}\
  } ;\
  register_rule<RULE_NAME> register_##RULE_NAME ;

#define FVMAMR_TRANSFER_VECTOR_RULE(RULE_NAME,CURRENT_VAR,PREVIOUS_VAR, \
                                    CURRENT_KEY,PREVIOUS_KEY, \
