  /// Read a named option from a nested AMR metric option list. Missing options
  /// return the caller-provided default; present options must be names/strings.
  inline std::string amrGetOptionName(const options_list &options,
                                      const std::string &option,
                                      const std::string &defaultValue,
                                      const std::string &context)
  {
    if(!options.optionExists(option))
      return defaultValue ;

    option_value_type valueType = options.getOptionValueType(option) ;
    if(valueType != NAME && valueType != STRING) {
      if(MPI_rank == 0) {
        std::cerr << "ERROR: AMR option '" << option << "' for " << context
                  << " must be a name" << std::endl ;
      }
      Abort() ;
    }

    std::string value ;
    option_values optionValue = options.getOption(option) ;
    optionValue.get_value(value) ;
    return value ;
  }

  /// Read a real-valued option from a nested AMR metric option list. This is used
  /// for metric weights, which are dimensionless scale factors.
  inline double amrGetOptionDouble(const options_list &options,
                                   const std::string &option,
                                   double defaultValue,
                                   const std::string &context)
  {
    if(!options.optionExists(option))
      return defaultValue ;

    if(options.getOptionValueType(option) != REAL) {
      if(MPI_rank == 0) {
        std::cerr << "ERROR: AMR option '" << option << "' for " << context
                  << " must be a real value" << std::endl ;
      }
      Abort() ;
    }

    double value = defaultValue ;
    options.getOption(option,value) ;
    return value ;
  }

  /// Read an integer option from a nested AMR option list. The vars parser
  /// stores numeric values as reals, so reject non-integral values explicitly.
  inline int amrGetOptionInt(const options_list &options,
                             const std::string &option,
                             int defaultValue,
                             const std::string &context)
  {
    if(!options.optionExists(option))
      return defaultValue ;

    if(options.getOptionValueType(option) != REAL) {
      if(MPI_rank == 0) {
        std::cerr << "ERROR: AMR option '" << option << "' for " << context
                  << " must be an integer value" << std::endl ;
      }
      Abort() ;
    }

    double value = double(defaultValue) ;
    options.getOption(option,value) ;
    const int intValue = int(value) ;
    if(std::fabs(value-double(intValue)) > 1.0e-12) {
      if(MPI_rank == 0) {
        std::cerr << "ERROR: AMR option '" << option << "' for " << context
                  << " must be an integer value" << std::endl ;
      }
      Abort() ;
    }
    return intValue ;
  }

  /// Read a boolean option from a nested AMR option list.
  inline bool amrGetOptionBool(const options_list &options,
                               const std::string &option,
                               bool defaultValue,
                               const std::string &context)
  {
    if(!options.optionExists(option))
      return defaultValue ;

    if(options.getOptionValueType(option) != BOOLEAN) {
      if(MPI_rank == 0) {
        std::cerr << "ERROR: AMR option '" << option << "' for " << context
                  << " must be true or false" << std::endl ;
      }
      Abort() ;
    }

    bool value = defaultValue ;
    options.getOption(option,value) ;
    return value ;
  }

  /// Convert the bracketed option-list syntax used by adaptSensorMetrics into an
  /// options_list object. For example, [type=scalar,weight=0.5] becomes an
  /// options list with entries named type and weight.
  inline options_list amrOptionsFromList(const options_list::arg_list &args,
                                         const std::string &context)
  {
    options_list options ;
    try {
      options.Input(args) ;
    } catch(const BasicException &err) {
      if(MPI_rank == 0) {
        std::cerr << "ERROR: Unable to parse AMR metric options for "
                  << context << std::endl ;
        err.Print(std::cerr) ;
      }
      Abort() ;
    }
    return options ;
  }

  inline std::string amrLowerString(const std::string &input)
  {
    std::string value = input ;
    for(size_t i=0;i<value.size();++i)
      value[i] = char(std::tolower(static_cast<unsigned char>(value[i]))) ;
    return value ;
  }

  inline int amrRequestCommandFromName(const std::string &command,
                                       const std::string &context)
  {
    const std::string value = amrLowerString(command) ;
    if(value == "refine" || value == "refinement")
      return AMR_REQUEST_REFINE ;
    if(value == "coarsen" || value == "coarsening" ||
       value == "derefine" || value == "de-refine")
      return AMR_REQUEST_COARSEN ;
    if(value == "none" || value == "keep" || value == "unchanged")
      return AMR_REQUEST_NONE ;

    if(MPI_rank == 0) {
      std::cerr << "ERROR: Unknown AMR request command '" << command
                << "' for " << context << std::endl ;
    }
    Abort() ;
    return AMR_REQUEST_NONE ;
  }

  inline int amrGetRequestCommandOption(const options_list &options,
                                        const std::string &option,
                                        int defaultValue,
                                        const std::string &context)
  {
    if(!options.optionExists(option))
      return defaultValue ;

    option_value_type valueType = options.getOptionValueType(option) ;
    if(valueType == REAL)
      return amrNormalizeRequestCommand(
        amrGetOptionInt(options,option,defaultValue,context)) ;
    if(valueType == NAME || valueType == STRING)
      return amrRequestCommandFromName(
        amrGetOptionName(options,option,"none",context),context) ;

    if(MPI_rank == 0) {
      std::cerr << "ERROR: AMR option '" << option << "' for " << context
                << " must be a request command" << std::endl ;
    }
    Abort() ;
    return defaultValue ;
  }

