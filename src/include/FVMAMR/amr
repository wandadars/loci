  } ;

  /// Base rule for interpolating a staged scalar parent field onto adapted cells.
  class AMRRestartScalar : public pointwise_rule {
    std::string outputVarName,keyName ;
    const_param<int> restartFlag ;
    const_blackbox<AMRinterpolation> mapping ;
    store<real_t> childData ;
  public:
    AMRRestartScalar(const std::string &outputVarName,
                     const std::string &keyName,
                     const std::string &constraintName,
                     const std::string &restartConstraintName,
                     const std::string &domainConstraintName,
                     const std::string &restartFlagName,
                     const std::string &mappingName) :
      outputVarName(outputVarName),keyName(keyName)
    {
      name_store(outputVarName,childData) ;
      name_store(restartFlagName,restartFlag) ;
      name_store(mappingName,mapping) ;
      input(restartFlagName) ;
      input(mappingName) ;
      output(outputVarName) ;
      constraint(restartConstraintName) ;
      constraint(domainConstraintName) ;
      if(constraintName != "")
        constraint(constraintName) ;
      disable_threading() ;
    }

    void compute(const sequence &) {
      store<real_t> parent ;
      storeRepP ptr = getAMRDBItem(keyName) ;
      if(ptr == 0) {
        std::cerr << "ERROR: " << keyName
                  << " not found in DataXFER_DB." << std::endl ;
        Abort() ;
      }
      parent = ptr ;
      mapping->interpolateData(parent,childData) ;
      parent.allocate(EMPTY) ;
      deleteAMRDBItem(keyName) ;
    }
  } ;

