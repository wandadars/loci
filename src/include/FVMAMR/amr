  /// Typed names for the legacy FVMAdapt DataXFER_DB entries used during
  /// in-memory adaptation. These wrappers document the string contract without
  /// moving ownership of remeshing data out of FVMAdapt.
  enum AMRDBKey {
    AMR_DB_ADAPT_CYCLE,
    AMR_DB_REFINE_TAG,
    AMR_DB_CELL_WEIGHTS,
    AMR_DB_CURRENT_PLAN,
    AMR_DB_NEXT_PLAN,
    AMR_DB_C2P,
    AMR_DB_C2P_GLOBAL,
    AMR_DB_CELL_PARTITION_WEIGHTS,
    AMR_DB_GRAD_CELLS,
    AMR_DB_DELTAS,
    AMR_DB_VOL,
    AMR_DB_CENTERS
  } ;

  /// Return the DataXFER_DB key string associated with a typed AMR key.
  inline const char *amrDBKeyName(AMRDBKey key)
  {
    switch(key) {
    case AMR_DB_ADAPT_CYCLE:            return "adaptCycle" ;
    case AMR_DB_REFINE_TAG:             return "refineTag" ;
    case AMR_DB_CELL_WEIGHTS:           return "cellweights" ;
    case AMR_DB_CURRENT_PLAN:           return "currentPlan" ;
    case AMR_DB_NEXT_PLAN:              return "nextPlan" ;
    case AMR_DB_C2P:                    return "c2p" ;
    case AMR_DB_C2P_GLOBAL:             return "c2pglobal" ;
    case AMR_DB_CELL_PARTITION_WEIGHTS: return "cellPartitionWeights" ;
    case AMR_DB_GRAD_CELLS:             return "gradCells" ;
    case AMR_DB_DELTAS:                 return "deltas" ;
    case AMR_DB_VOL:                    return "vol" ;
    case AMR_DB_CENTERS:                return "centers" ;
    }
    return "" ;
  }

  /// Fetch a DataXFER_DB item by raw key name. Prefer the enum overload when
  /// the key is part of the common FVMAMR/FVMAdapt contract.
  inline storeRepP getAMRDBItem(const std::string &keyName)
  {
    return DataXFER_DB.getItem(keyName) ;
  }

  /// Fetch a common AMR DataXFER_DB item by typed key.
  inline storeRepP getAMRDBItem(AMRDBKey key)
  {
    return getAMRDBItem(amrDBKeyName(key)) ;
  }

  /// Test whether a raw DataXFER_DB key is currently staged.
  inline bool hasAMRDBItem(const std::string &keyName)
  {
    return getAMRDBItem(keyName) != 0 ;
  }

  /// Test whether a common AMR key is currently staged.
  inline bool hasAMRDBItem(AMRDBKey key)
  {
    return getAMRDBItem(key) != 0 ;
  }

  /// Replace a raw DataXFER_DB entry. The old value is deleted first so callers
  /// can safely restage the same key during repeated adaptation cycles.
  inline void replaceAMRDBItem(const std::string &keyName,storeRepP item)
  {
    DataXFER_DB.deleteItem(keyName) ;
    DataXFER_DB.insertItem(keyName,item) ;
  }

  /// Replace a common AMR DataXFER_DB entry.
  inline void replaceAMRDBItem(AMRDBKey key,storeRepP item)
  {
    replaceAMRDBItem(amrDBKeyName(key),item) ;
  }

  /// Delete a raw DataXFER_DB entry if present.
  inline void deleteAMRDBItem(const std::string &keyName)
  {
    DataXFER_DB.deleteItem(keyName) ;
  }

  /// Delete a common AMR DataXFER_DB entry if present.
  inline void deleteAMRDBItem(AMRDBKey key)
  {
    deleteAMRDBItem(amrDBKeyName(key)) ;
  }

  /// Remove stale parent-child maps before a newly adapted mesh is staged.
  inline void clearAMRParentChildKeys()
  {
    deleteAMRDBItem(AMR_DB_C2P) ;
    deleteAMRDBItem(AMR_DB_C2P_GLOBAL) ;
  }

  /// True when the generic tagging rules have staged nonzero refinement tags.
  inline bool hasAMRRefineTags()
  {
    return hasAMRDBItem(AMR_DB_REFINE_TAG) ;
  }

  /// Convert adaptMode to the split-mode integer expected by onlineRefineMesh:
  /// 2D -> 1, isotropic -> 2, and anisotropic/default -> 0.
  inline int amrSplitModeFromAdaptMode(const std::string &mode)
  {
    if(mode == "2D")
      return 1 ;
    if(mode == "isotropic")
      return 2 ;
    return 0 ;
  }

  /// Read AMR vars-file facts, update the low-level FVMAdapt globals, and
  /// return the split-mode integer that the driver passes to onlineRefineMesh().
  inline int configureFVMAdaptGlobals(fact_db &facts)
  {
    int adaptMode = 0 ;

    storeRepP modePtr = facts.get_variable("adaptMode") ;
    if(modePtr != 0) {
      param<std::string> modeParam ;
      modeParam = modePtr ;
      adaptMode = amrSplitModeFromAdaptMode(*modeParam) ;
    }

    storeRepP edgePtr = facts.get_variable("adaptMinEdgeLength") ;
    if(edgePtr != 0) {
      param<double> adaptMinEdgeLength ;
      adaptMinEdgeLength = edgePtr ;
      Globals::tolerance = (*adaptMinEdgeLength)/10.0 ;
    }

    storeRepP faceFoldPtr = facts.get_variable("adaptFaceFold") ;
    if(faceFoldPtr != 0) {
      param<double> adaptFaceFold ;
      adaptFaceFold = faceFoldPtr ;
      Globals::fold = *adaptFaceFold ;
    }

    return adaptMode ;
  }

  /// Create one adaptSensor(NAME) boolean fact used by parametric sensor rules.
  inline void createAdaptSensorFact(fact_db &facts,const std::string &name)
  {
    const std::string switchVar =
      std::string("adaptSensor(") + name + std::string(")") ;
    if(facts.get_variable(switchVar) == 0) {
      param<bool> adaptSwitch ;
      *adaptSwitch = true ;
      facts.create_fact(switchVar,adaptSwitch) ;
    }
  }

  /// Parse adaptSensor as a comma expression and expand it into
  /// adaptSensor(NAME) facts. Applications call this after vars are loaded.
  inline void setupAdaptSensorFacts(fact_db &facts)
  {
    storeRepP asensor = facts.get_variable("adaptSensor") ;
    if(asensor == 0)
      return ;

    param<std::string> adaptSensor ;
    adaptSensor = asensor ;
    const std::string sensorList = *adaptSensor ;
    if(sensorList == "")
      return ;

    exprP ep = expression::create(sensorList) ;
    if(ep == 0) {
      if(MPI_rank == 0)
        std::cerr << "ERROR: Unable to interpret expression in 'adaptSensor'"
                  << std::endl ;
      Abort() ;
    }

    exprList sensors = collect_associative_op(ep,OP_COMMA) ;
    for(exprList::const_iterator li=sensors.begin();li!=sensors.end();++li) {
      if((*li)->op != OP_NAME) {
        if(MPI_rank == 0) {
          std::cerr << "ERROR: Unable to interpret expression in 'adaptSensor'"
                    << std::endl ;
          (*li)->Print(std::cerr) ;
        }
        Abort() ;
      }
      createAdaptSensorFact(facts,(*li)->name) ;
    }
  }

  /// Redistribute a local cell store into the file-order distribution expected
  /// by FVMAdapt's AMR interpolation support.
  inline storeRepP redistributeAMRStoreToFileOrder(storeRepP rep,entitySet dom,
                                                   fact_db::distribute_infoP dist)
  {
    Map l2f ;
    getL2FMap(l2f,dom,dist) ;
    std::vector<int> splits ;
    FindSimpleDistribution(dom,l2f,splits,MPI_COMM_WORLD) ;
    storeRepP vardist = 0 ;
    redistributeStore(vardist,rep,dom,l2f,splits,MPI_COMM_WORLD) ;
    return vardist ;
  }

  /// Base rule for staging a scalar cell field before in-memory AMR remapping.
  /// Solvers instantiate this with their own field names and DB keys.
  class AMRTransferScalar : public pointwise_rule {
    std::string currentVarName,previousVarName,currentDBName,previousDBName ;
    bool hasPrevious ;
    const_store<real_t> currentVar ;
    const_store<real_t> previousVar ;
    param<bool> outputVar ;
  public:
    AMRTransferScalar(const std::string &currentVarName,
                      const std::string &previousVarName,
                      const std::string &currentDBName,
                      const std::string &previousDBName,
                      const std::string &constraintName,
                      const std::string &conditionalName,
                      const std::string &domainConstraintName,
                      const std::string &outputName) :
      currentVarName(currentVarName),previousVarName(previousVarName),
      currentDBName(currentDBName),previousDBName(previousDBName),
      hasPrevious(previousVarName != "" && previousDBName != "")
    {
      name_store(currentVarName,currentVar) ;
      if(hasPrevious)
        name_store(previousVarName,previousVar) ;
      name_store(outputName,outputVar) ;
      input(currentVarName) ;
      if(hasPrevious)
        input(previousVarName) ;
      output(outputName) ;
      conditional(conditionalName) ;
      constraint(domainConstraintName) ;
      if(constraintName != "")
        constraint(constraintName) ;
      disable_threading() ;
    }

    void compute(const sequence &seq) {
      entitySet dom = entitySet(seq) ;
      fact_db::distribute_infoP dist =
        exec_current_fact_db->get_distribute_info() ;

      store<real_t> currentSave ;
      currentSave.allocate(dom) ;
      for(sequence::const_iterator si=seq.begin();si!=seq.end();++si) {
        Entity ii = *si ;
        currentSave[ii] = currentVar[ii] ;
      }
      replaceAMRDBItem(currentDBName,
                       redistributeAMRStoreToFileOrder(currentSave.Rep(),
                                                       dom,dist)) ;

      if(hasPrevious) {
        store<real_t> previousSave ;
        previousSave.allocate(dom) ;
        for(sequence::const_iterator si=seq.begin();si!=seq.end();++si) {
          Entity ii = *si ;
          previousSave[ii] = previousVar[ii] ;
        }
        replaceAMRDBItem(previousDBName,
                         redistributeAMRStoreToFileOrder(previousSave.Rep(),
                                                         dom,dist)) ;
      }
    }
  } ;

